// ---------------------------------------------
// Random Dialogues in the houses of Iltkazar
// ---------------------------------------------

// Iltkazar – Random House Dialogues

BEGIN ~AC#IL5RD~

IF ~RandomNum(15,1)~ THEN BEGIN 0 
  SAY ~Was sucht ihr in meinem Haus? Raus hier, bevor ich die Wache rufe!~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,2)~ THEN BEGIN 1 
  SAY ~Ihr steht im Weg. Entweder ihr habt etwas zu sagen – oder ihr geht.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,3)~ THEN BEGIN 2 
  SAY ~Besucher? In diesen Zeiten? Hmpf. Macht nichts kaputt.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,4)~ THEN BEGIN 3 
  SAY ~Wenn ihr nach Bier sucht – ich habe keins. Wenn ihr Ärger sucht, erst recht nicht.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,5)~ THEN BEGIN 4 
  SAY ~Der Stein hier ist alt. Älter als ihr. Behandelt ihn mit Respekt.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,6)~ THEN BEGIN 5 
  SAY ~Ich habe gerade gegessen. Schlechter Zeitpunkt für Gespräche.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,7)~ THEN BEGIN 6 
  SAY ~Wenn ihr vom Rat kommt, sagt ihnen: Ich zahle meine Abgaben pünktlich.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,8)~ THEN BEGIN 7 
  SAY ~Hm? Ach… ich dachte, ihr wärt jemand anderes. Vergesst es.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,9)~ THEN BEGIN 8 
  SAY ~Die Wände hören hier besser zu als die Leute. Also passt auf, was ihr sagt.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,10)~ THEN BEGIN 9 
  SAY ~Früher war hier mehr Ruhe. Und es waren weniger Fremde!~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,11)~ THEN BEGIN 10 
  SAY ~Ich habe nichts zu verkaufen und nichts zu verbergen.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,12)~ THEN BEGIN 11 
  SAY ~Der Ofen zieht schlecht heute. Ein schlechtes Omen.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,13)~ THEN BEGIN 12 
  SAY ~Wenn ihr Hilfe sucht, seid ihr hier falsch. Ich kümmere mich nur um mein eigenes Gestein.~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,14)~ THEN BEGIN 13 
  SAY ~Ein langer Tag. Und er wird nicht kürzer, wenn ihr hier steht!~
  IF ~~ THEN EXIT
END

IF ~RandomNum(15,15)~ THEN BEGIN 14 
  SAY ~Geht wieder. Manche Dinge bleiben besser hinter verschlossenen Türen.~
  IF ~~ THEN EXIT
END

