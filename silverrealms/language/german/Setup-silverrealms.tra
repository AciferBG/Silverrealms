@5023 = ~Hicks!~ [HICCUP]

/***************************
// Area Description strings
***************************/

	// ACIL5D - Dugmaren's Temple
@6000 = ~Diese Statue stellt Dugmaren Leuchtmantel, den zwergischen Gott der Forschung und der Kreativität, dar.~
@6001 = ~Das heilige Symbol Dugmarens, ein aufgeschlagenes Buch.~
@6002 = ~Nach einem langen Irrweg durch das Unterreich erreicht Ihr endlich Gänge, die denen um Iltkazar ähnlich sind.~
@6003 = ~Dieses helle Licht scheint Spinnen zu vertreiben.~
@6004 = ~Der Drow-Teleportationsstein verschwindet aus Eurem Inventar.~
	// ACIL28: Barakuir
@6005 = ~Diese Statue stellt Laduguer, den Schutzpatron der Duergar, dar.~
@6006 = ~Eine Euch unbekannte Zwergenstatue blickt finster auf Euch herab.~
@6007 = ~Das Symbol Laduguers: Ein Schild mit einem zerbrochenen Pfeil.~
@6008 = ~Auf diesem Wappen sind ein Schild und ein zerbrochener Pfeil zu sehen.~
@6009 = ~Die Runen in altem Dethek lauten: "Barakuir, das Eisenkönigreich.
Stolze Heimat von Clan Duergar."~
@6010 = ~Auf dieser Tafel sind Zwergenrunen eingelassen, die Ihr nicht entziffern könnt.~
@6011 = ~Dies scheinen die verschrumpelten Überreste eines Ältestenhirnes zu sein. Durch das besondere Klima in der Kammer ist die Verwesung nicht weit fortgeschritten. Trotzdem stinkt es fürchterlich nach Fäulnis und Zerfall.~
@6012 = ~Ein riesiges Gehirn ruht leblos in diesem ausgetrockneten Becken. Der Gestank ist fürchterlich.~
	// ACIL52: Haela's Halls
@6013 = ~Ein steinernes Bildnis eines Betrachters.~
@6014 = ~Diese Flaggen zeigen das Symbol von Tief Duerra, einen Schädel mit vier Tentakeln.~
@6015 = ~Diese Bronzeplatte zeigt die zwei bösen Vettern der Zwergenrasse: Die Duergar und die Derro.~
@6016 = ~Auf dieser Platte steht geschrieben: "Die Zwillingssöhne Moradins - Diinkarazan und Diirinka - wegen ihrer Verbrechen aus dem Kreise der Morndinsammen verstoßen."~
@6017 = ~"Kriegsbeute der Drow: Spinnen-Opfertisch und Tentakelpeitsche"~
@6018 = ~Kriegsflagge des Clan Duergar mit dem Symbol Laduguers~
@6019 = ~Der Gnädige Hof~
@6020 = ~Ein mumifizierter Kopf eines Gedankenschinders~
@6021 = ~Ein Wächter der Prachtaxthalle Alatorins~
@6022 = ~Das Vermächtnis~
@6023 = ~"Taark Shanat erschlägt vier blaue Drachen und formt daraus den legendären Drachenschädelthron."~
@6024 = ~Tempel von Haela Leuchtaxt~
	// ACIL57: Dumathoin's Crypt
@6025 = ~Die fein gearbeitete Statue einer jungen Elfin.~
@6026 = ~Dieser Durchgang ist eingestürzt.~
@6027 = ~Die Seile des Lastenaufzuges sind gerissen.~
@6028 = ~Die leuchtenden Runen an den mächtigen Säulen wurden zerschlagen.~
@6029 = ~Das Abbild Diirinkas, des gefallenen Zwergengottes des Königreiches Torglor.~
@6030 = ~Auf dieser spiralförmig angeordneten Runentafel steht geschrieben: 
'Torglor, 
Silberkönigreich,
Diirinka'~
@6031 = ~Ihr spürt einen Ruck, hört einen Knall und stürzt in die Tiefe. Gerade, als Euch klar wird, dass die Seile des Lastenaufzuges gerissen sind, schlagt Ihr unsanft auf einem Steinboden auf. Es dauert eine Weile, bis Ihr Euch in der Dunkelheit zurechtfindet.~
// ACIL56: Bronzemask
@6032 = ~Diese Statue stellt Gorm Gulthyn, den zwergischen Gott der Verteidigung, dar.~
@6033 = ~Tempel des Gorm~
@6034 = ~Rüstkammer~
@6035 = ~Diese Statue stellt den Gnomengott Gaerdal Eisenhand dar.~
@6036 = ~Tempel des Gaerdal~
@6037 = ~Trainingshalle~
@6038 = ~Kugelkammer~
//ACIL51: Ancient Forge
@6040 = ~Tempel des Moradin~

// ACIL58: Hall of Omlars

// ACIL4O
@6100 = ~Diese Tür hat kein Schloss. Es muss einen anderen Mechanismus geben, um sie zu öffnen.~
@6101 = ~Dieser kleine Kasten besitzt eine Vorrichtung, in die man einen Schlüssel stecken kann.~

// ACIL9B
@6102 = ~Keiner der Gegenstände in Eurem Inventar eignet sich dazu, in die Fassung gesetzt zu werden.~
@6103 = ~Die verwittere Statue eines Zwerges. Er schien früher etwas in den Händen gehalten zu haben, sein Blick zeigt nach rechts auf einen bestimmten Wandbereich der Höhle.~
@6104 = ~Dieser geheime Durchgang besitzt kein sichtbares Schloss. Es muss einen anderen Mechanismus geben, um ihn zu öffnen.~

// ACIL06 - Axebridge
@6110 = ~Axtbrücke~
@6111 = ~Ein starkes Feuer hat diese Bäume vollständig niedergebrannt.~

// ACIL20 - Underdark #2 (other entries at @872ff)
@6200 = ~Auf diesem Schild sind ein Pfeil nach unten, ein Hammer und mehrere Blitze dargestellt. Die Leiter daneben scheint in tiefere Minenbereiche zu führen.~
@6201 = ~Nummaks Stollen~

// ACIL25 - Spiderstalkings #2 (other entries at @4 ff)
@6251 = ~Dies ist das Symbol der ausgestoßenen Drow-Göttin Zinzerena, einer Feindin der Spinnenkönigin Lolth und ausgesprochenen Spinnenhasserin.~
@6252 = ~Eine Statue der ausgestoßenen Drow-Gottheit Zinzerena, in ihrer typischen Darstellung mit Mantel und Dolch. Ihre rechte Hand ist ausgestreckt, als würde sie einen Zauber wirken, und ihre Augen betrachten konzentriert den Altar zu ihren Füßen. Eine feine Inschrift ziert ihr Gewand: "Die Beine einer Spinne sind dazu geschaffen, um zerbrochen zu werden."~
@6253 = ~Ihr platziert die tote Spinne auf dem Altar, und spürt, wie der Raum von einer fremdartigen Macht erfüllt wird. Die Aura scheint mächtiger als bei den Ritualen zuvor. Auf ihrem Höhepunkt manifestiert sich auf dem Altar ein magischer Stab, bevor die Energie in sich zusammenfällt. Die Magie ist erloschen, und Ihr werdet auf dem Altar keine weiteren Gegenstände mehr erschaffen können.~

// ACIL53 - Dugmaren temple (other entries at @1122 & @1123
@6300 = ~Tempel des Dugmaren~

// Area script Strings
@7000 = ~Ihr müsst die Schwebescheibe, das Quecksilber und den Levitationstrank auf den Altar legen, um die Scheibe wieder verzaubern zu können.~
@7001 = ~In dieser Position klemmt ein Zahnrad, welches wohl jenseits dieses Raumes aktiviert wird.~
@7002 = ~Dies scheint ein defekter Mechanismus zu sein, der eine Tür öffnet. Es fehlt ein Zahnrad.~
@7003 = ~Ihr setzt das Zahnrad an die dafür passende Stelle.~
@7004 = ~Ihr benötigt ein Zahnrad, um den Mechanismus wieder in Gang zu bringen.~
@7005 = ~Ihr habt das Zahnrad bereits eingesetzt und könnt nun den Mechanismus im anderen Raum dazu verwenden, die Türe in den Tunnel zu öffnen.~



// Item Strings
@8000 = ~Schlauschopf~
@8001 = ~Zwerge gelten nicht gerade als Inbegriffe geistiger Höchstleistungen. Auf Baldric traf dies jedoch nicht zu. Er war ein Liebhaber von Kraknakur, einem zwergischen Brettspiel, welches entfernt an Schach erinnert und mit Steinfiguren gespielt wird. Baldric schien jeden Zug seiner Kontrahenten vorauszusehen und brachte es so zu Ruhm und Ehre. Der Legende nach forderte der Zwerg in einem epischen Spiel den Ulithariden einer benachbarten, verfeindeten Gedankenschinder-Enklave zum Duell am Steinbrett heraus. Es ging um nicht weniger als die Freiheit oder Versklavung seines Clans. Allen Berichten zufolge gewann Baldric hauchdünn gegen den Illithiden, welcher sich jedoch nicht an die Abmachung hielt und das Hirn des armen Baldric verschlang, bevor er von den zwergischen Zuschauern niedergeschlagen werden konnte. Baldrics Helm galt seit dieser Zeit als Reliquie in den Hallen seines Clans, bis die Zwergengemeinde schlussendlich doch von den Illithiden versklavt wurde. Danach verlor sich die Spur des Helmes in den Weiten des Unterreiches.

SPEZIFISCHE EIGENSCHAFTEN:

Intelligenz: +2
Besondere Eigenschaften: Schützt vor kritischen Treffern
Gewicht: 2
Kann nicht verwendet werden von:
Magiern
Barden
Dieben~
@8002 = ~Frischer Fang~
@8003 = ~Frischer Fang +2, +5 gegen Fischwesen
Der Speer war eine der ersten Waffen, die von Menschenhand gefertigt wurde. Die ersten Speere waren nicht viel mehr als Holzstangen, die an einem Ende zugespitzt waren. Als die Menschheit lernte, mit Metall zu arbeiten, wurden die Speerspitzen aus Eisen oder Stahl gefertigt. Dann begannen die Waffenschmiede, mit verschiedenen Arten von Speerspitzen zu experimentieren. Aus den Experimenten heraus entstanden die verschiedenen Arten von Stangenwaffen. Weitere Experimente führten zur Herstellung magischer Speere. So wurden Speere beispielsweise vom Schamanen eines Stammes verzaubert, damit sie der Stammeskrieger rascher führen konnte und ein Treffer beim Feind mehr Schaden anrichtete.

SPEZIFISCHE EIGENSCHAFTEN:

ETW0: -2
Schaden: 1W6+2 (Stichwaffe), doppelter Schaden gegen fischartige Wesen wie Kuo-Toa 
Gewicht: 3
Initiativefaktor: 4
Waffenfertigkeit: Speer
Waffentyp: Beidhändig
Kann nicht verwendet werden von:
Klerikern
Magiern
Dieben~
@8004 = ~Drow-Elfenkettenhemd +1~
@8005 = ~Drow-Elfenkettenhemd +1
Die Drow verstehen es, Werkstücke äußerst grazil, aber gleichzeitig stabil zu fertigen. Dadurch können sie wunderbare Dinge schaffen, die dennoch praktisch verwendbar sind. Dazu gehören beispielsweise Drow-Kettenhemden. Derartige Kettenhemden sind so fein gewebt, dass man sie unauffällig unter normaler Kleidung tragen kann. Sie behindern in keiner Weise und sind so leicht, dass sie auch Diebe und Krieger/Magier einsetzen können, ohne dass ihre Fähigkeiten eingeschränkt werden. Aufgrund des grazilen Schnittmusters ist dieses Kettenhemd nur für Elfen und Halbelfen geeignet. Während sich höherwertige Drow-Rüstungen jedem neuen Träger anpassen, haben die Drow bei der Herstellung einfacher magischer Gegenstände wie diesem darauf verzichtet - vermutlich auch, um ihren zahlreichen Feinden nicht gut gearbeitete Rüstungen in die hände fallen zu lassen, denn Kettenhemden wie dieses sind die Standardausrüstung der klassischen Fußsoldaten der Drow, die in großen Einheiten das Unterreich heimsuchen.
Die Rüstung ist, wie die meisten Ausrüstungsgegenstände der Drow, aus einer Adamantitlegierung hergestellt. Daher zerfällt sie zu Staub, wenn man sie aus dem Unterreich ins Sonnenlicht bringt.

SPEZIFISCHE EIGENSCHAFTEN:
Kann nur verwendet werden von: Elfen und Halbelfen
Rüstungsklasse: 4
Gewicht: 12
Kann nicht verwendet werden von:
Druiden
Magiern
Kensai~
@8006 = ~Kupferplatte~
@8007 = ~Qualith-Runenplatte~
@8008 = ~Diese Platte aus angelaufenem Kupfer zieren seltsame, horizontal verlaufende Linien.~
@8009 = ~Diese Platte ist mit Qualith-Runen, der Schrift der Gedankenschinder, versehen. Auf ihr steht in den für die Schrift typischen Linien geschrieben:
"Die Zwergenstadt ist überflutet, und viele unserer Rasse sind jämmerlich ertrunken. Der Tempel ist verloren. Wir sind von Wasser eingeschlossen und können nicht zurück. Hunger macht sich breit, und Einige haben schon aus Gier und Verzweiflung begonnen, die Hirne ihrer Kameraden zu verspeisen, jetzt, wo keine niederen Rassen mehr übrig sind, an denen wir uns laben können. Wir können das Ältestenhirn nicht mehr ernähren, und so bleibt uns nur die Wahl zwischen Tod oder Untod."~
@8010 = ~Heiliger Hammer~
@8011 = ~Dies ist der heilige Hammer Dumathoins aus dem Tempel Iltkazars. Man müsste die Waffe genauer untersuchen, um etwas über ihre Kräfte erfahren zu können.~
@8012 = ~Verzierter Stein~
@8013 = ~Drow-Teleportationsstein~
@8014 = ~Diesen Stein zieren auffällige Runen.~
@8015 = ~Teleportationssteine dieser Art werden von den Hausmagiern der Drow häufig eingesetzt, um sich ihr Leben leichter zu machen - oder um es im Notfall zu schützen. Allerdings ist die Wirkung solcher Steine häufiger auf einen kleinen Radius begrenzt, vermutlich, um Missbrauch vorzubeugen. Deshalb funktioniert dieser spezielle Teleportationsstein nur in den Spinnenschächten. Sobald Ihr das Gebiet gen Iltkazar wieder verlasst, wird sich der Stein wegteleportieren.

SPEZIFISCHE EIGENSCHAFTEN:
Der Anwender kann sich dreimal täglich an einen Ort in seiner Sichtweite teleportieren.
Die Wirkung des Steines ist auf die Spinnenschächte begrenzt.
~
@8016 = ~Ellhimars Tagebuch~
@8017 = ~Dies ist das Tagebuch des Magiers Ellhimar aus Iltkazar. Er scheint es hier verloren zu haben, als er von den Drow überwältigt worden ist. Es ist in einer feinen, akkuraten Handschrift verfasst. Ihr blättert viele Seiten nach hinten, um Euch auf das Wesentliche - Ellhimars Erkenntnisse über den schlafenden König - zu konzentrieren.
23. Alturiak 1367, im Jahr des Schildes
Der König ist nicht zu der errechneten Zeit aus seinem Schlaf erwacht. In den ersten Wochen, die seitdem verstrichen sind, hat sich die Zwergengemeinde noch keine großen Sorgen gemacht. Dies ist nun, seit der zweite Monat verstrichen ist, anders. Ganz Iltkazar sucht hektisch nach einer Möglichkeit, den König aus seinem mysteriösen Zustand zu befreien.

3. Ches 1367, im Jahr des Schildes
Man hat mich endlich zum König vorgelassen. Sein Zustand ist seltsam und beunruhigend. Wüsste ich es nicht besser, würde ich sagen, dass ich einer Mithrilstatue gegenüberstehe. All meine Erkenntnis- und Bannzauber haben nichts gebracht. Was ist so mächtig, dass es sich meiner Magie widersetzen kann?

9. Tarsakh 1367, im Jahr des Schildes
Die Priester der Zwerge versuchen noch immer, ihren König mit aller verfügbaren Magie zu erwecken. Nichts scheint zu helfen. Auch der Segen ihrer Götter hat keinen Erfolg.

2. Eleint 1367, im Jahr des Schildes
Ich habe auf eigene Faust Nachforschungen angestellt.  König Mith Barak selbst hatte vor seinem letzten Schlafe versucht, seinen mysteriösen Zustand zu beenden. Berichten der Zwerge zufolge brach er alleine zu einer Expedition in ein Gebiet, das die Zwerge "Spinnenschächte" nennen, auf. Bei seiner Rückkehr ließ er die Eingänge versiegeln. Die Zwerge denken, dass es zu ihrem Schutz sei. Doch ich denke, dass Mith Barak dort etwas hinterlegt hat. Und wenn es nur eine Nachricht ist. Denn die Hinweise für einen Außenstehenden waren zu offensichtlich. Den Zwergen selbst fällt so etwas freilich nicht auf. Man hat fast den Eindruck, als würde Mith Barak seiner eigenen Rasse nicht vertrauen. Warum nur?

17. Uktar, 1367, im Jahr des Schildes
Ich glaube, ich weiß, warum die Zauber der Priester Iltkazars alle verschwendet sind. Mith Barak ist keiner der ihren. Alles, was ich über ihn finden konnte, nährt diesen Verdacht. Nur was ist er dann?

23. Mirtul 1368, im Jahr des Banners
Es gibt nur eine Möglichkeit, dem Rätsel um Mith Barak näher zu kommen: Ich werde in die Spinnenschächte aufbrechen und sehen, was Mith Barak dort hinterlassen hat.

24. Mirtul 1368, im Jahr des Banners
Ich bin in der Kapelle des Blutigen Mondes angekommen. Ein uralter Tempel zu Ehren eines Menschen- und eines Zwergengottes. Mith Barak ist vermutlich keines von beidem, doch es passt ins Bild, dass er sich hier in der Abgeschiedenheit aufgehalten hat. Der uralte, mythalgleiche Zauber, der diesen Tempel einnimmt wie dichter Nebel ist auffällig. Es scheint so, dass die Erschaffer den Zauber gewebt haben, um in einen tiefen Schlaf fallen zu können. Geht es um Visionen?

...ich bin unglaublich müde, der Zauber zehrt fürchterlich an meinen Kräften. Die Statuen stellen Fragen zur Geschichte der alten Zwergenreiche. Ich habe vier richtig beantwortet. Nun werde ich gleich die letzte Frage beantworten. Ich muss mich nur noch kurz wach halten, denn wenn die letzte Frage beantwortet wurde, setzt die Vision des Zaubers ein, die Mith Barak wahrscheinlich in diesen Ort gewebt hat. Der König muss ein famoser Künstler des Arkanen sein, wenn man sich die mächtige Magie ansieht, die er hier manipuliert hat. So etwas würde kein "normaler" Zwerg zustande bringen. Ich glaube, ich weiß jetzt, was Mith Barak ist. Es gibt nur eine Möglichkeit. Aber alles der Reihe nach. Erst die letzte Frage. Kurz die Augen schließen, neue Kräfte sammeln, und dann geht es los.

(Hier endet das Tagebuch.)
~
@8018 = ~Tethirs Mondklinge~
@8019 = ~Mondklingen werden seit der Zeit des alten Myth Drannor von außergewöhnlichen Helden des elfischen Volkes getragen. Die Schwerter werden meist von einer Generation auf die nächste vererbt. In seltenen Fällen kann die Klinge von einem anderen Elfen geführt werden, wenn der ursprüngliche Besitzer gestorben ist und das Schwert den neuen Träger anerkennt. Dies ist jedoch nur bei gut gesinnten Elfen der Fall. Alle anderen Gesinnungen und Rassen scheitern bei dem Versuch, die Klinge anzuheben.
Die Mondklinge ist eine mächtige Waffe. Jede verfügt über ganz individuelle Fähigkeiten, die nicht mit einer anderen Mondklinge identisch sind und maßgeblich vom ersten Träger beeinflusst werden. In diesem Falle schenkt Tethirs Mondklinge ihrem Träger Schutz vor Feuer. Außerdem kann der Besitzer einmal täglich einen Elfschatten, ein identisches Duplikat seiner selbst, erschaffen, welches für ihn kämpft. Die Stufe des Elfschattens betragt 60% der Stufe des Trägers. Es verfügt über alle Zauber und Fähigkeiten, über die der Träger auf dieser Stufe verfügen könnte. Seine Trefferpunkte betragen 60% der Trefferpunkte des Trägers. Der Elfschatten steht unter der vollständigen Kontrolle des Trägers. Wird der Elfschatten getötet, kehrt er in das Schwert zurück. 

SPEZIFISCHE EIGENSCHAFTEN:

Besondere Fähigkeiten: Träger erhält 50% Feuerresistenz
Träger kann einmal täglich einen Elfschatten, ein Abbild seiner selbst, herbeizaubern
ETW0: -3
Schaden: 1W8+3 (Klingenwaffe)
Gewicht: 4
Initiativefaktor: 5
Waffenfertigkeit: Langschwert
Waffentyp: einhändig
Kann nur von Elfen guter Gesinnung verwendet werden.~
@8020 = ~Schmelztiegel~
@8021 = ~Dieser Tiegel wird benutzt, um flüssiges Metall zu gießen. Er hat einen langen Arm und scheint sehr stabil zu sein.~
@8022 = ~Roher Rubin~
@8023 = ~Rubin ist ein Korund und wird wegen seines funkelnden Glanzes und seiner leuchtenden Farben sehr geschätzt. Er kann als klarer Stein, in karmesinrot oder in tiefem karminrot gefunden werden. Von etwa hundert Rubinen hat einer einen weißen Stern in seinem Herzen und ist bekannt als ein Sternrubin. Das gemeine Volk hält Rubine im Allgemeinen für Glücksgegenstände. 
Rubinstaub hat eine Vielzahl von magischen Verwendungen, einschließlich einer Schlüsselrolle als Zutat in Zauberfarben der Elementar- und Sonnenzauber-Sphären oder in Schwächungs-, Veränderungs- und Beschwörungsschulen. 45 Rubine sind wesentliche Merkmale eines Helms der Brillanz und sind die bevorzugten Edelsteine in jedem Gegenstand, der Heilung verspricht. Richtig eingesetzt, können sie Blitze und Erdbeben (sowohl natürliche als auch magische) abwenden.~
@8024 = ~Schwarznatter~
@8025 = ~Langschwert +2, 'Schwarznatter'
 
Diese Klinge gehört zu den Waffen, die "Lebensstehler" genannt werden, da bei einem Treffer eine gewisse Wahrscheinlichkeit besteht, dass ein Teil der Lebensenergie des Opfers auf den Träger des Schwertes übertragen wird.


SPEZIFISCHE EIGENSCHAFTEN:

ETW0: -2
Schaden: 1W8 +2 (Klingenwaffe)
Besondere Fähigkeiten: Entzieht zu 5% dem Opfer 3d6 Trefferpunkte und fügt diese dem Träger des Schwertes zu
Gewicht: 3
Initiativefaktor: 3
Waffenfertigkeit: Langschwert
Waffentyp: einhändig
Mindeststärke: 6
Kann nicht verwendet werden von:
 Druiden
 Klerikern
 Magiern~
@8026 = ~Schutz vor Gift~
@8027 = ~Schutz vor Gift (Bannzauber)
Schutz- und Elementarzyklus
Grad: 2
Reichweite: Berührung
Wirkungsdauer: 10 Runden 
Zeitaufwand: 3
Wirkungsbereich: Das berührte Wesen
Rettungswurf: Keiner

Durch die Anwendung dieses Zaubers wird die gewählte Kreatur immun gegen Gifte, die über Kontakt mit der Haut, Verschlucken oder Stich verabreicht werden. Gifte anderer Arten wirken weiterhin normal auf das Wesen. Alle Gifte, die sich bereits im Körper befinden, wenn der Zauber gewirkt wird, sind ebenfalls von diesem Zauberspruch nicht betroffen.~
@8028 = ~Torglor-Zepter~
@8029 = ~Dies ist das Torglor-Zepter, eines der alten Herrschaftszepter des Zwergenreiches Shanatar. Der Griff ist aus Mithril gefertigt, und der Kopf ist mit einer Bronzeplatte verziert, der auf der einen Seite die Insignien eines unbekannten Clans zeigt, auf der anderen Seite das Symbol Diirinkas, des alten und gefallenen Schutzpatrons Torglors und jetzigen Gott der Derro. Trotz seiner Größe eignet sich das Zepter erstaunlich gut als Waffe und kann wie ein Streitkolben geschwungen werden, da es sich auf wundersame Weise verkleineren und vergrößern kann, um leicht in einer Hand im Kampf geschwungen zu werden. Allein diese Fähigkeit zeigt eindrucksvoll, welches handwerkliche Geschick die Zwerge in das Relikt eingearbeitet haben.
Es verfügt sicher noch über weitere versteckte Kräfte, die sich Euch jedoch nicht ohne weiteres erschließen.

SPEZIFISCHE EIGENSCHAFTEN:

ETW0: -2
Schaden: 1W6+3 (Wuchtwaffe)
Gewicht: 7 
Initiativefaktor: 5
Waffenfertigkeit: Streitkolben
Waffentyp: Einhändig
Kann nicht verwendet werden von:
Druiden
Magiern
Dieben~
@8030 = ~Brüchige Substanz~
@8031 = ~Gottesblut~
@8032 = ~Ihr habt keinen blassen Schimmer, was diese Substanz sein könnte. Es ist kristallin, aber für ein Mineral viel zu weich und klebrig. Man kann es mit den bloßen Händen in kleine Klumpen zerreiben.~
@8033 = ~Dies ist das geronnene Blut eines verstorbenen Gottes. In der Astralebene findet man häufiger Brocken dieser Substanz, und es ranken sich unter den Ebenenreisenden zahlreiche Geschichten um die Wirkung dieser nicht sehr geschmackvollen Körperflüssigkeit. Gottesblut ist jedoch eine mächtige Substanz, die den Körper von allen schädlichen Substanzen reinigen kann. Dadurch wird jede Krankheit und jedes Gift neutralisiert. Anschließend werden noch 40 erlittene Schadenspunkte wiederhergestellt. Man muss sich nur überwinden, die ekelerregenden Krümel zu verspeisen.~
@8034 = ~Dies ist das Blut eines verstorbenen Gottes. Einige Tropfen dieser zähen Substanz sollen dazu in der Lage sein, einen Verstorbenen wiederauferstehen zu lassen.~
@8035 = ~Nebelspalter~
@8036 = ~Nebelspalter

Diese unheilige Klinge ist ein Schwert +4, das über große Illusionskräfte verfügt. Wird es im Kampf geschwungen, profitiert der Anwender von einem Versetzungszauber, dessen Dauer unbegrenzt ist. Wird der Unschärfezauber irgendwie aufgelöst, versetzt das Schwert den Anwender automatisch in eine andere Position und gewährt ihm die gleichen Vorteile wie ein Mantel der Versetzung. Wenn das Schwert in der Scheide steckt, kann der Anwender bis zu dreimal am Tag seine Gestalt verändern. Einmal pro Woche kann das Schwert einen geisterhaften Mörder erschaffen.
Zwei dieser unheimlichen Waffen, beides Zweihänder, wurden von den Gelehrten beschrieben. Beide ähneln sich im Aussehen, haben einen silbernen Griff und sind reich mit Perlen verziert. Die eine befindet sich irgendwo im hohen Norden in den Händen von Gornag, einem Anführer der Frostriesen, der die massive Klinge einhändig und mit großer Geschicklichkeit führt. Das Pendant wurde vor etwa einem Jahrzehnt in den Ruinen von Solon gefunden, obwohl es offensichtlich nicht aus dieser Gegend stammt. Die mittlere Perle an der Stelle, an der sich die Parierstangen treffen und die Klinge beginnt, ist von der seltenen schwarzen Sorte und ein königliches Lösegeld wert. Leider ging die Waffe kurz nach ihrer Entdeckung an eine githyankische Kriegstruppe verloren. Jeder, der mutig genug ist, die Githyanki auf der Astralebene herauszufordern, kann sie zurückerhalten.

SPEZIFISCHE EIGENSCHAFTEN:

Besondere Fähigkeiten: Auf dem Träger liegt ein Versetzungszauber, wenn er die Klinge in der Hand hält.
ETW0: -4
Schaden: 1W10+4 (Klingenwaffe)
Gewicht: 10
Initiativefaktor: 6
Waffenfertigkeit: Zweihänder
Waffentyp: Beidhändig
Kann nicht verwendet werden von:
Druiden
Klerikern
Magiern
Dieben
Charakteren mit guter Gesinnung

~
@8037 = ~Todesbolzen~
@8038 = ~Dieser Bolzen ist pechschwarz. Er wurde hergestellt, um ein bestimmtes Wesen, und nur dieses eine Wesen, zu töten. Der unglückliche Auserwählte ist in diesem Fall ein Kuo-Toa.

SPEZIFISCHE EIGENSCHAFTEN:

ETW0: -3
Schaden: 1W8 (Fernkampfwaffe, Stichwaffe) 
Spezielle Merkmale: Tötet einen Kuo-Toa bei einem erfolgreichen Treffer
Gewicht: 0
Wird verschossen von: Armbrust~
@8039 = ~Pfeil der Heilung~
@8040 = ~Diese sorgfältig gefertigten Pfeile sind sehr selten. Es wird angenommen, dass sie von einer schon lange nicht mehr existierenden Kaste von Priestern hergestellt worden sind. Der Schaft eines Heilungspfeils ist ein einfaches, glattes Stück Holz. Die Befiederung ist in der Regel sehr farbenfroh, in leuchtenden Grün-, Blau- und Rottönen gehalten - möglicherweise die Federn von Papageien. Die Pfeilspitze ist aus geschliffenem Schiefer und mit einem mächtigen Heilzauber versehen.
Wenn die Pfeilspitze in ein Ziel eingedrungen ist, sei es durch Abfeuern des Pfeils auf das Ziel oder durch Einstechen als Speer oder Dolch, verursacht der Pfeil einen Schadenspunkt. Sobald die Pfeilspitze jedoch versenkt wurde, setzt sie einen Heilzauber frei, der 2w10 Punkte Schaden heilt. Die Pfeilspitze wird durch den Zauber aufgelöst und der Schaft kann daraufhin mühelos entfernt werden.
Gelehrte vermuten, dass diese Pfeile auf im Gefecht verwundete Kämpfer abgefeuert wurden, um ihnen zu helfen, länger in den vorderen Reihen zu überleben.

SPEZIFISCHE EIGENSCHAFTEN:

ETW0: -1
Schaden: 1W1+1 (Stichwaffe)
Spezielle Merkmale: Heilt bei einem erfolgreichen Treffer 2w10 Trefferpunkte bei dem Ziel
Gewicht: 0
Wird verschossen von: Bogen
Kann nicht verwendet werden von:
 Klerikern
 Druiden
 Magiern~
@8041 = ~Drow-Brief~
@8042 = ~Drow-Brief (entziffert)~
@8043 = ~Fridj ka usstan'bal ulu sultha nindel zhuanth dwarven yath wun lil' har'olen: lil' lgor ssrig'luin natha kaas de' draa phraktos: Clangeddin lueth nindol rivvil drathir Quarval-sharess usstan h'ros ajak.  Xsa shinduago xellased!~
@8044 = ~Falls ich wieder diesen alten Zwergentempel in den Höhlen betreten muss notiere ich mir die Parole: Die Steinfigur verlangt die Namen zweier Götter, um Einlass zu gewähren - Clangeddin und den Namen dieser menschlichen Mondgöttin, an den ich mich nicht erinnern kann. Verdammte Oberflächenbewohner!~ 
@8045 = ~Cinnabarit~
@8046 = ~Cinnabarit ist ein durchscheinendes bis undurchsichtiges Mineral und weist auf sichtbaren Kristallflächen einen diamant- bis metallähnlichen Glanz auf. Die Farbe von Cinnabarit ist von einem charakteristisch leuchtenden und auch als Farbe bekannten Zinnoberrot. Durch Fremdbeimengungen kann das Mineral aber auch eine braunrote bis bleigraue Farbe annehmen. Seine Strichfarbe ist jedoch immer ein kräftiges Rot. Cinnabarit ist das wichtigste und häufigste Quecksilber-Mineral. Daneben wurde Zinnober als Farbe seit Anbeginn der Kunst von vielen Rassen in der Malerei verwendet.~
@8047 = ~Quecksilber ist ein silberweißes, flüssiges Schwermetall. Es wird manchmal noch zu den Edelmetallen gezählt. Es bildet mit sehr vielen Metallen Legierungen und wird für verschiedene Verzauberungen als Komponente benötigt. Dieses Quecksilber habt Ihr aus Cinnabarit hergestellt, um es für die Verzauberung der Drow-Schwebescheibe zu verwenden. Dorna Abgrundlied im Tempel Dugmarens in der Halle der Runensteine benötigt diesen Gegenstand, um Euch zu helfen.~
@8048 = ~Schlüssel zu Nimmuks Stollen~
@8049 = ~Ihr habt diesen Schlüssel von Dorna Abgrundlied erhalten, um den Zugang zu einem alten Stollen, der "Nimmuks Stollen" genannt wird, öffnen zu können. Dorna erwähnte noch, dass der Stollen versiegelt wurde, da es darin spuken soll.~
@8050 = ~Kromthruns Handschuhe~
@8051 = ~Anhänger des Duergar-Gottes Laduguer streben ein Leben lang nach Perfektion. Hier kommt ihnen häufig die finstere Wesensart ihres Gottes in die Quere, der seinen Anbetern ein Dasein in Mühsal und Qualen abverlangt.
Dies musste auch der grauzwergische Schmied Kromthrun erfahren, als er versuchte, mit dem Segen des Grauen Beschützers, der auch als "Der Harsche" bekannt ist, dieses Paar Handschuhe zu erschaffen. Der Gegenstand schenkte ihm zwar die erhoffte Muskelkraft eines Steinriesen, doch die Gewandheit und Trefferfertigkeit würde auf das Niveau eines Flumph reduziert.

SPEZIFISCHE EIGENSCHAFTEN:  

Stärke: auf 20 gesetzt
Geschicklichkeit: wird zu 3
ETW0: auf 20 gesetzt
Gewicht: 2
Kann nicht verwendet werden von:~
@8052 = ~Mantel des Schweigens~
@8053 = ~Mantel des Schweigens 
Dieser Umhang hüllt seinen Träger in eine Aura unheimlicher Stille und dämpft jegliches Geräusch, das von ihm ausgeht. So beliebt solche Umhänge bei Dieben und Spionen auch sein mögen, so unbeliebt sind sie doch bei den Anwendern arkaner Kunst, da jeder, der diesen Mantel anlegt, zum Schweigen verdammt ist und keine Zaubersprüche mehr wirken kann. Die Legende besagt, dass solch ein Mantel von einem berüchtigten Meuchelmörder Imaskars verwendet wurde. Im passenden Moment stülpte er seinen Umhang über sein ahnungsloses Opfer, dem dadurch jeglicher Hilferuf verwehrt blieb. Dies könnte erklären, weshalb nie jemand die Verbrechen des Assassinen gehört hatte, obwohl sie immer am hellichten Tage stattfanden.

SPEZIFISCHE EIGENSCHAFTEN:
 
Auf dem Träger liegt "Stille".
Im Schatten verstecken +30% 
Leise bewegen +30%

Gewicht: 3
Kann nicht verwendet werden von:~

@8054 = ~Diese Riesenspinnen sind tot sogar noch widerlicher als lebendig. Ihre hervorstehenden, kristallklaren Augen starren leer in deine Richtung, und ab und zu zuckt eines ihrer acht Beine krampfartig. Der Name der Minen, in dem Ihr die Spinne erschlagen hat - die Spinnenschächte - scheint passend gewählt, denn es wimmelt dort nur so vor diesen achtbeinigen Insekten. Vielleicht ist der tote Körper einer Spinne in diesen Gängen noch für etwas nütze?~

@8055 = ~Säureschutztrank~
@8056 = ~Wer diesen Trank zu sich nimmt, entwickelt eine magische Widerstandsfähigkeit gegen jede Art von Säure. Jeder Schaden, der durch Säure entsteht, wird um 50% reduziert. Die Widerstandsfähigkeit gegen Säure gilt zusätzlich zu anderen Formen der Resistenz, die eine Person besitzt. Die Wirkung hält 10 Runden lang an, bzw. bis sie gebannt wird.~
@8057 = ~Knoten und Netze: Die unerzählte Geschichte der Seilherstellung in Faerûn~
@8058 = ~Dieses umfangreiche und detaillierte Werk beleuchtet die oft übersehene Kunst der Seilherstellung in Faerûn. Marnik Seilflechter, ein gelehrter Halbling und selbsternannter "Seilhistoriker", erkundet die Evolution und die kulturelle Bedeutung von Seilen und Netzen durch die Jahrhunderte. Von den einfachen Bindetechniken der Fischer am Mondsee bis zu den komplexen Knoten, die von den Elfen von Evermeet für ihre Segelschiffe verwendet werden, bietet dieses Buch einen tiefen Einblick in ein alltägliches Werkzeug, das in der Geschichte vieler Kulturen Faerûns eine zentrale Rolle spielt.

Neben technischen Beschreibungen und Anleitungen zum Knüpfen verschiedener Knoten umfasst das Buch auch Gespräche mit bekannten Seilmachern, Anekdoten aus der Seilherstellung und Diskussionen über die Verwendung von Seilen in der Militärstrategie. Ebenso wird die Rolle von Seilen in der Magie und in verschiedenen Ritualen beleuchtet, sowie ihre symbolische Bedeutung in der Mythologie Faerûns.

Während es sich um ein spezifisches und scheinbar nebensächliches Thema handelt, bietet "Knoten und Netze" eine faszinierende Perspektive auf die Art und Weise, wie ein einfaches Handwerk die sozialen, wirtschaftlichen und magischen Aspekte einer Gesellschaft durchdringen kann.~
@8059 = ~Die Melodien des Meißels: Musikalische Traditionen in den Steinmetzgilden von Faerûn~
@8060 = ~Dieses Werk erforscht die einzigartige Verbindung zwischen Musik und Steinmetzarbeit, wie sie in den Zwergen- und Menschengemeinschaften Faerûns praktiziert wird. Thondrin Klangbart, ein Zwerg und ehemaliger Meistersteinmetz, der auch als begnadeter Harfenspieler bekannt ist, enthüllt, wie rhythmische Klänge und Melodien die Arbeit der Steinmetze beeinflussen und inspirieren.

"Die Melodien des Meißels" beschreibt detailliert, wie bestimmte Melodien verwendet werden, um die Arbeitsmoral zu steigern, die Präzision zu erhöhen und mühsame Arbeitsstunden zu erleichtern. Das Buch enthält Noten und Beschreibungen spezifischer Lieder, die während der Steinbearbeitung gesungen werden, sowie die Geschichten hinter diesen Liedern, die oft tief in der Geschichte und den Mythen der jeweiligen Kultur verwurzelt sind.

Neben den theoretischen Erörterungen beinhaltet das Buch eine Sammlung von Liedern und deren Notation, die Steinmetze während der Arbeit singen, sowie Gespräche mit alten Meistern, die Traditionen und Techniken besprechen, die möglicherweise ohne diese musikalische Dokumentation verloren gegangen wären.

"Die Melodien des Meißels" bietet nicht nur eine kulturelle Einsicht in die Arbeit von Steinmetzen, sondern zeigt auch, wie Musik als universelle Sprache dient, die Gemeinschaften verbindet und die harte Arbeit verschönert. Es ist ein Zeugnis für die oft übersehene künstlerische Seite des Handwerks.~
@8061 = ~Die ungeschriebene Geschichte der Goblinkunst in Faerûn~
@8062 = ~Dieses bahnbrechende Werk von Garik Steinleser, einem zwergischen Archäologen und Kunsthistoriker, wirft Licht auf die oft übersehenen und missverstandenen künstlerischen Ausdrucksformen der Goblins in Faerûn. Das Buch bricht mit gängigen Vorurteilen und präsentiert eine gründliche Untersuchung der Goblinkunst, von rauen Höhlenmalereien bis zu grob gehauenen Skulpturen.

Das Buch bietet eine detaillierte Analyse der verwendeten Materialien, Techniken und der kulturellen Bedeutung der Kunstwerke der Goblins. Es enthält sorgfältige Skizzen und detaillierte Zeichnungen von Kunstwerken, die in verlassenen Goblinhöhlen und anderen verborgenen Stätten gefunden wurden. Diese Darstellungen werden ergänzt durch Interpretationen ihrer symbolischen Bedeutungen und Diskussionen über die sozialen Strukturen, die solche Kunstwerke hervorgebracht haben.

Das Buch beinhaltet auch Kapitel über die Interaktion zwischen Goblin-Künstlern und anderen Kulturen in Faerûn sowie die Einflüsse, die diese Begegnungen auf die künstlerischen Stile hatten. Es bietet Vergleiche mit zeitgenössischer Kunst von Menschen, Zwergen und Elfen, um Gemeinsamkeiten und Unterschiede herauszuarbeiten.

Der Wälzer ist ein wichtiges akademisches Werk, das dazu beiträgt, die Goblinkultur in Faerûn anzuerkennen und wertzuschätzen. Es ist auch ein Plädoyer für eine breitere Sicht auf das, was Kunst ist und sein kann, und fordert die Leser auf, die Komplexität und den Wert kreativer Ausdrucksformen in allen Formen und von allen Völkern an- und zu erkennen.~
@8063 = ~Eiserner Wille: Die Geschichte der Zwergenwiderstände in Faerûn~
@8064 = ~Dieses tiefgründige Werk von Balin Eisenfaust, einem geschätzten Zwergenhistoriker, dokumentiert die zahlreichen Widerstandsbewegungen der Zwerge gegen verschiedene Unterdrücker in der Geschichte Faerûns. Es untersucht die strategischen, sozialen und kulturellen Aspekte des zwergischen Widerstands und bietet Einblicke in einige der entscheidendsten und prägendsten Konflikte.

"Eiserner Wille" beginnt mit den frühesten Aufzeichnungen zwergischer Siedlungen und beschreibt detailliert verschiedene bedeutende Aufstände, darunter die Befreiung der Zwergenstadt Gauntlgrym von der Herrschaft böser Mächte und den langen Kampf der Zwerge des Eisensternklans gegen die Eindringlinge aus den Ebenen. Jedes Kapitel kombiniert historische Fakten mit persönlichen Geschichten von Zwergen, die in diesen Kämpfen eine zentrale Rolle spielten.

Neben der historischen Analyse enthält das Buch auch taktische Karten und Diagramme, die die Schlachtfelder und Verteidigungsstrategien der Zwerge veranschaulichen. Weiterhin werden Briefe und Tagebucheinträge zitiert, die die emotionalen und persönlichen Aspekte der Kriege beleuchten.

"Eiserner Wille" ist mehr als eine bloße Sammlung historischer Ereignisse; es ist eine Hommage an die Zähigkeit und den unerschütterlichen Geist der Zwerge. Das Buch ist eine wertvolle Ressource für jeden, der die tiefen Wurzeln des Zwergenstolzes und der Unabhängigkeit verstehen möchte und zeigt auf, wie diese Vergangenheit die zwergische Gesellschaft bis heute prägt.~
@8065 = ~Federleichte Fehltritte: Eine kritische Betrachtung der elfischen Arroganz~
@8066 = ~In diesem scharfzüngigen und kontroversen Werk nimmt Thrain Spottbart, ein Zwerg mit einem ausgeprägten Sinn für Humor und wenig Geduld für Elfen, die Missgeschicke und die angebliche Überlegenheit der elfischen Völker unter die Lupe. Das Buch ist eine Sammlung von Essays, Anekdoten und satirischen Kommentaren, die die Fehler und Eigenheiten der Elfen hervorheben.

"Federleichte Fehltritte" deckt eine breite Palette von Themen ab, von der angeblichen Unsterblichkeit der Elfen, die Spottbart als "endlose Gelegenheit, Fehler zu wiederholen" beschreibt, bis hin zu ihrer Kunst und Kultur, die er als "übertrieben und prätentiös" kritisiert. Weitere Kapitel befassen sich mit elfischen Regierungsformen, militärischen Strategien und diplomatischen Fehlschlägen, die alle durch den spöttischen Blick des Autors gefiltert werden.

Das Buch enthält humorvolle Illustrationen, die elfische Charaktere in übertriebenen und komischen Posen darstellen, sowie fiktive Dialoge und Briefe, die elfische Arroganz und Naivität satirisch darstellen.

Obwohl das Buch zweifellos provokativ ist und sicherlich einige Kontroversen auslösen wird, bietet es auch Einblicke in die zwergische Sichtweise auf ihre langjährigen Nachbarn und Rivalen. "Federleichte Fehltritte" dient nicht nur der Unterhaltung, sondern regt auch zum Nachdenken über die Beziehungen und Vorurteile zwischen verschiedenen Kulturen an.~
@8067 = ~Stahl unter Sternen: Die Geschichte der Zwergenreiche unter dem Himmel Faerûns~
@8068 = ~"Stahl unter Sternen" ist ein umfassendes und tiefgreifendes historisches Werk von Durgar Stahlarchivar, einem renommierten Zwergenhistoriker. Dieses Buch erforscht die Entwicklung und den Einfluss der großen Zwergenreiche in Faerûn, von den alten Tagen ihrer Gründung bis zu ihrem heutigen Status.

Das Buch beginnt mit der Gründung der frühesten Zwergenfestungen und beschreibt detailliert ihren Aufstieg, ihre Blütezeiten und die Herausforderungen, denen sie sich durch die Jahrhunderte stellen mussten. Besonderes Augenmerk wird auf bedeutende Ereignisse wie die Schlacht von Azanulbizar, den Niedergang von Delzoun und die Wiederbelebung der Mithralhalle gelegt. Jedes Kapitel enthält detaillierte Beschreibungen der politischen, wirtschaftlichen und militärischen Strategien, die die Zwerge anwandten, um ihre Reiche zu verteidigen und zu erweitern.

"Stahl unter Sternen" ist reich illustriert mit Karten alter und neuer Zwergenstädte, kunstvollen Darstellungen von wichtigen historischen Persönlichkeiten und Schlachten sowie Diagrammen, die die Architektur und Ingenieurskunst der Zwerge zeigen.

Dieses Buch dient als ein entscheidendes Nachschlagewerk für alle, die sich für die Geschichte der Zwerge in Faerûn interessieren. Es bietet nicht nur historische Fakten, sondern auch Einblicke in die Kultur und Philosophie der Zwerge, ihre Beziehungen zu anderen Völkern und ihre unauslöschliche Prägung auf die Geographie und Politik der Region.~
@8069 = ~Echos von Delzoun: Aufstieg und Niedergang des Nordreichs~
@8070 = ~"Echos von Delzoun" ist ein umfangreiches historisches Werk, das sich auf eines der größten Zwergenreiche Faerûns konzentriert: Delzoun, das "Nordreich". Verfasst von Bronn Steinschlag, einem Gelehrten, der sein Leben der Erforschung vergessener Zivilisationen gewidmet hat, bietet dieses Buch eine gründliche Analyse der politischen, kulturellen und militärischen Geschichte Delzouns.

Das Buch erzählt von der Gründung Delzouns durch herausragende Gestalten der Zwergengeschichte und folgt dem Reich durch seine goldenen Zeiten, in denen es als Zentrum des Handels, der Kunst und des Handwerks galt. Es beleuchtet die internen und externen Konflikte, die schließlich zum schrittweisen Niedergang des Reiches führten, einschließlich der Invasionen durch Orks und andere feindliche Mächte. Besondere Aufmerksamkeit wird den berühmten Minen und Schmieden von Delzoun gewidmet, sowie den legendären Artefakten, die dort geschaffen wurden.

Neben den ausführlichen historischen Erörterungen enthält "Echos von Delzoun" kommentierte Reproduktionen von Artefakten, Skizzen von Festungsarchitekturen und Porträts bedeutender Persönlichkeiten aus Delzouns Geschichte. Ein besonderes Highlight sind die "Verlorenen Schriften von Delzoun", eine Sammlung neu entdeckter Dokumente, die zusätzliche Einblicke in das tägliche Leben und die Regierungsformen des Reiches bieten.

Dieses Buch ist unerlässlich für Historiker, Abenteurer und alle, die sich für die Geschichte der Zwerge und die Geheimnisse alter Reiche interessieren. "Echos von Delzoun" ist nicht nur eine Chronik eines vergangenen Reiches, sondern auch eine Quelle der Inspiration und ein Mahnmal für die Vergänglichkeit politischer und kultureller Macht.~
@8071 = ~Das Murren der Berge: Über die seltenen Kinder des Steins~
@8072 = ~"Das Murren der Berge" ist ein tiefsinniges Werk von Durin Altfels, einem angesehenen zwergischen Gelehrten, das die niedrige Kinderzahl der Zwerge und deren Auswirkungen auf die Zwergenreiche in Faerûn untersucht. Durch die Kombination von geschichtlicher Forschung, kultureller Betrachtung und persönlich gesammelten Berichten bietet dieses Buch einen umfassenden Blick auf ein Thema, das selten in den Annalen der Zwerge besprochen wird.

Durin Altfels führt den Leser durch die verwobenen Pfade gesellschaftlicher, traditioneller und naturgegebener Bedingungen, die zur geringen Kinderzahl der Zwerge beitragen. Er beleuchtet die Auswirkungen dieser Herausforderung für die Verteidigung der Zwergenfestungen, die Bewahrung ihrer überlieferten Sitten und die Stabilität. Besonders hervorgehoben wird die Bedeutung der Familienbande, der Erbnachfolge und der rituellen Werte der Fortpflanzung in der zwergischen Gemeinschaft.

Das Buch enthält Auszüge aus alten zwergischen Schriften, Sagen, die die göttlichen Einflüsse auf die Fruchtbarkeit der Zwerge darstellen, sowie Darstellungen und Stammbäume, die die Linien bedeutender zwergischer Familien über Jahrhunderte verfolgen.

"Das Murren der Berge" bietet somit nicht nur Einblicke in die lebenswichtigen und seelischen Aspekte der zwergischen Fortpflanzungskrise, sondern regt auch zu Diskussionen über mögliche Lösungswege und die zukünftige Ausrichtung zwergischer Führung und Kultur an. Es ist ein unverzichtbares Werk für alle, die ein tiefes Verständnis für die zwergischen Völker und ihre Herausforderungen suchen.~
@8073 = ~Der Gerstensaft der Götter: Ein Leitfaden zur Bierbraukunst in Faerûn~
@8074 = ~"Der Gerstensaft der Götter" ist ein umfassendes und feierliches Werk, verfasst von Thamior Gerstenbart, einem Meisterbrauer und geschätzten Chronisten der Braukunst. Dieses Buch erkundet die reiche Tradition und die vielfältigen Techniken des Bierbrauens, wie sie in den verschiedensten Ecken Faerûns praktiziert werden.

Das Werk führt den Leser durch die Geschichte des Bierbrauens in Faerûn, von den uralten Brauereien der Zwerge in ihren Bergfestungen bis zu den ausgefeilten Braustilen der Menschen in den Städten und Dörfern. Thamior Gerstenbart beschreibt detailliert die Auswahl der Zutaten, die Geheimnisse des Malzens, das kunstvolle Kochen des Würzes und die heiligen Gärverfahren, die jedem Bier seinen einzigartigen Charakter verleihen. Das Buch enthält auch Anweisungen zum Brauen spezieller Biere für festliche Anlässe, darunter Kampagnenbier für Schlachten und Hochzeitsbier für feierliche Gelübde.

"Der Gerstensaft der Götter" ist reich illustriert mit handgezeichneten Abbildungen von Brauereianlagen, Gerätschaften und den verschiedensten Biersorten. Zudem sind traditionelle Lieder und Trinksprüche enthalten, die in den Tavernen und Festhallen Faerûns gesungen werden.

Dieses Buch ist nicht nur eine Verneigung vor dem beliebten Getränk der Völker Faerûns, sondern auch ein unverzichtbarer Leitfaden für angehende Brauer und Kenner. Thamior Gerstenbart vermittelt sein tiefes Wissen und seine Begeisterung für das Brauhandwerk auf eine Weise, die sowohl den Laien als auch den Experten anspricht.~
@8075 = ~Schatten unter Faerûn: Das verborgene Reich der Drow~
@8076 = ~"Schatten unter Faerûn" ist ein gründlich recherchiertes Werk von Elanil Elassidil, einer Elfenforscherin, die sich auf das Studium des Unterreichs und ihrer Bewohner spezialisiert hat. Dieses Buch bietet einen tiefen Einblick in die mysteriöse und oft missverstandene Gesellschaft der Drow, den Dunkelelfen Faerûns.

Das Buch erforscht die komplexe Hierarchie und die kulturellen Praktiken der Drow, von ihrer erbitterten Verehrung der Spinnengöttin Lolth bis zu ihren politischen Machtkämpfen innerhalb der matriarchalischen Strukturen. Elanil untersucht auch die Beziehungen der Drow zu anderen Unterreichsbewohnern sowie ihre sporadischen Interaktionen mit der Oberwelt. Besondere Kapitel widmen sich den berühmten Persönlichkeiten der Drow-Geschichte, ihren Künsten der Magie und Täuschung und den legendären Geschichten, die sich um ihre dunklen Helden und Schurken ranken.

"Schatten unter Faerûn" enthält seltene Einblicke in die religiösen Rituale und Feierlichkeiten der Drow sowie Analysen ihrer Sprache und ihres Schrifttums. Zudem sind künstlerische Darstellungen von Drow-Siedlungen, Tempeln und gesellschaftlichen Ereignissen enthalten, die von Elanil während ihrer verdeckten Forschungen in der Unterwelt gesammelt wurden.

Dieses Buch bietet nicht nur eine akademische Perspektive auf die Drow, sondern versucht auch, einige der Vorurteile und Missverständnisse zu entkräften, die oft mit diesen dunklen Kreaturen verbunden sind. Es ist ein entscheidendes Werk für jeden, der sich für die dunkleren Aspekte Faerûns und die komplexe Dynamik seiner Unterwelt interessiert.~
@8077 = ~Der Zwerg und der Elf~
@8078 = ~Die Nacht war kalt und die Winde aus dem Norden trugen das Heulen der Wölfe mit sich. Durik Eisenfaust und Aramil Silberfaden hatten sich unabhängig voneinander in die kleine Taverne am Rande des Hohen Waldes geflüchtet, jeder auf der Flucht vor dem aufziehenden Sturm. Als sie sich das erste Mal begegneten, musterten sie sich mit dem Misstrauen, das ihre Völker seit Äonen hegte.

Durik, dessen Bart vom Frost leicht angezuckert war, brummte leise, als er den Elfen ansah. "Ich dachte, euresgleichen würde sich in den Wäldern verstecken, nicht in der Höhle eines Zwerges."

Aramil, dessen schlanke Statur fast schattenhaft wirkte im flackernden Licht des Kamins, lächelte dünn. "Und ich war der Meinung, Zwerge würden lieber unter der Erde bleiben als hier oben, wo der Himmel auf ihre Köpfe fallen kann."

Ein rauer Lacher entwich Durik, und etwas in seinem Blick erhellte sich. "Vielleicht sind wir beide hier, weil wir vor demselben Sturm fliehen."

Bevor Aramil antworten konnte, durchbrach ein lautes Krachen die Stimmung. Die Tür der Taverne flog auf, und eine Bande von Goblins stürmte herein, ihre grinsenden Gesichter beleuchtet von den Fackeln, die sie schwangen. In diesem Moment des Chaos vergaßen der Zwerg und der Elf ihre Vorurteile. Sie zogen ihre Waffen – ein breites Schwert für Durik und einen langen, schlanken Zauberstab für Aramil – und standen Rücken an Rücken.

Während sie kämpften, Seite an Seite, begann eine seltsame Verbindung zwischen ihnen zu wachsen. Jeder Schlag von Duriks Schwert wurde durch einen Spruch von Aramil ergänzt, und bald waren die Goblins überwältigt und die Taverne wieder sicher.

Als die letzte Bedrohung beseitigt war, sanken beide, immer noch Rücken an Rücken, keuchend nieder. "Nicht schlecht für einen Elfen," keuchte Durik.

Aramil lachte leise, sein Atem bildete kleine Wolken in der kalten Luft. "Und du bist zäher, als ich es von einem Zwerg erwartet hätte."

In dieser Nacht, bei einem weiteren Becher starken Biers, begannen die beiden, ihre Geschichten zu teilen. Mit jeder Erzählung, die sie austauschten, verblassten die alten Vorurteile, und die Grundlage einer unwahrscheinlichen, aber festen Freundschaft wurde gelegt.~
@8079 = ~Im Schatten der Spinnenkönigin: Weniger bekannte Götter der Drow~
@8080 = ~Während Lolth in den Gesängen und Flüchen vieler Völker als die tyrannische Spinnenkönigin der Drow bekannt ist, existiert ein Pantheon weniger bekannter Gottheiten, die im Dunkel ihrer Schatten agieren. Hier soll ein kurzer Überblick über drei solche Gottheiten gegeben werden: Zinzerena, Vhaeraun und Ghaunadaur. Diese Zusammenfassung basiert auf gesammelten Erzählungen, alten Schriftrollen und den wenigen Begegnungen, die mein Volk mit Anhängern dieser Götter hatte.

Zinzerena: Die Meisterin der Illusion
Zinzerena wird oft als die Göttin der Täuschung und der Intrige dargestellt. Sie ist bekannt für ihre List und ihre Fähigkeit, sowohl die Wahrnehmung als auch die Realität zu manipulieren. Ihre Anhänger sehen in ihr eine Befreierin von den Fesseln der strengen hierarchischen Gesellschaft der Drow. Zinzerena ist eine Patronin für jene, die sich durch List und Tücke einen Vorteil verschaffen wollen, sei es durch Magie oder durch das einfache Weben von Intrigen.

Vhaeraun: Der Maskierte Herr
Vhaeraun, bekannt als der Maskierte Herr oder der Dunkle Schatten, ist der Gott der Diebe, der Schattenarbeit und des Widerstands gegen die matriarchalische Ordnung der Drow. Er lehrt seine Anhänger, dass Gleichheit und Freiheit durch Heimlichkeit und Subversion erlangt werden können. Vhaeraun fordert den Status quo heraus, indem er die männlichen Drow ermutigt, gegen die Unterdrückung durch die weiblichen Priesterinnen von Lolth zu kämpfen. Sein Kult ist geheimnisvoll und operiert aus dem Verborgenen, stets versteckt vor den Augen der Spinnenkönigin.

Ghaunadaur: Der Vergessene Alte
Ghaunadaur, der manchmal einfach als Der Vergessene Alte bezeichnet wird, ist eine Gottheit, deren Ursprünge weit zurückreichen, sogar vor die Zeiten der Drow. Er wird als der Gott des Schlundes, der Abscheulichkeiten und der Außenseiter verehrt. Seine Anhänger sind oft jene, die sich von der Gesellschaft ausgestoßen fühlen oder die in den dunkelsten Tiefen des Großen Unterreichs Zuflucht suchen. Ghaunadaur verlangt keine Unterwerfung unter komplexe Rituale, sondern einfach nur die Anerkennung seiner tiefen und ursprünglichen Macht.

Diese Gottheiten bilden ein komplexes Geflecht innerhalb der drowischen Kultur, das oft von Außenstehenden übersehen wird. Jeder von ihnen bietet einen anderen Weg für die Drow, ihre Gesellschaft und ihr Schicksal herauszufordern oder zu akzeptieren. Als Zwerg, der das Misstrauen und die Rivalität zwischen unseren Völkern kennt, erachte ich es dennoch als wesentlich, das Verständnis dieser Gottheiten zu vertiefen, um sowohl die Gefahren als auch die Möglichkeiten unserer Interaktionen mit den Drow besser zu begreifen.

Verfasst von: Urist Grauhelm~
@8081 = ~Geschöpfe der Tiefe: Wesen des Unterreichs~
@8082 = ~Das Unterreich, jene weitläufige und undurchdringliche Region unter der Oberfläche Faerûns, ist Heimat einer Vielzahl von Kreaturen, die so bizarr wie gefährlich sind. Dieses Buch bietet eine Übersicht über einige der weniger bekannten, aber ebenso faszinierenden Wesen, die in den dunklen Ecken und tiefen Höhlen dieser unterirdischen Welt leben. Von den wilden Quaggoths bis zu den furchteinflößenden Hakenschrecken, jede Kreatur offenbart die Vielfalt und die Herausforderungen dieses dunklen Reiches.

Quaggoths: Die Wilden aus der Tiefe
Quaggoths sind pelzige, menschenähnliche Wesen mit einer Vorliebe für das barbarische und brutale Leben. Ursprünglich stammen sie aus der Oberwelt, haben sich aber im Laufe der Jahrhunderte an das raue Leben im Unterreich angepasst. Sie sind bekannt für ihre außerordentliche Stärke und Ausdauer, was sie zu gefürchteten Gegnern macht. In den Stämmen der Quaggoths herrschen oft archaische und brutale Sitten, die ihre wilde Natur widerspiegeln.

Hakenschrecken : Die Lauscher der Tiefe
Hakenschrecken sind eine der unheimlichsten Kreaturen des Unterreichs. Diese Wesen haben mächtige, hakenförmige Klauen und eine dicke, chitinöse Haut, die sie vor den meisten Waffen schützt. Sie navigieren und jagen primär durch Gehör, was sie in den labyrinthartigen Höhlen besonders effektiv macht. Ihre unheimliche Präsenz und ihr abruptes Auftauchen sind oft Quelle von Schrecken und Legenden unter den Bewohnern des Unterreichs.

Weitere Monster des Unterreichs
Neben Quaggoths und Hakenschrecken beherbergt das Unterreich eine Vielzahl weiterer Kreaturen, die ebenso faszinierend wie tödlich sind. Zu diesen gehören die rätselhaften Myconiden, pilzartige Wesen, die über ein Netzwerk aus Sporen kommunizieren, sowie die gefürchteten Stichler, kleine, aber tödliche Kreaturen, die von Höhlenwänden und -decken auf ihre ahnungslosen Opfer herabfallen.

Das Unterreich birgt zahlreiche Geheimnisse und Gefahren, und die hier beschriebenen Wesen sind nur ein Bruchteil dessen, was mutige Abenteurer oder unglückliche Reisende erwarten könnte. Dieses Buch soll als Leitfaden dienen, um die unglaubliche Vielfalt des Lebens tief unter der Erde zu verstehen und sich vielleicht sogar darauf vorzubereiten. Als erfahrener Forscher der Tiefenwelt rate ich jedoch zur Vorsicht: Das Wissen um diese Kreaturen kann überlebenswichtig sein, doch oft ist die Flucht der klügere Teil des Heldentums.

Verfasst von: Norin Tiefensucher~
@8083 = ~Zwergenschlüssel~
@8084 = ~Dieser Schlüssel wurde von Zwergen gefertigt. Da ihn ein Zahnrad ziert, scheint er zu einem Raum zu gehören, der mit Mechanik zu tun hat.~
@8085 = ~Scheibe~
@8086 = ~Diese Scheibe aus Zwergenfertigung zieren viele Runen. Sie wurde wohl gefertigt, um in einen Mechanismus eingesetzt werden zu können.~
@8087 = ~Denfar~
@8088 = ~Denfar bedeutet in der Zwergensprache "Felszerstörer". Dies war der Name des Zwergenhelden, der den Helm in zahlreichen Schlachten trug. Denfar war ein Schlachtenwüter vom Clan Eisenbrust aus Barakuir, ein Zwergenreich, das besonders hart durch den Krieg mit den Gedankenschindern getroffen wurde. Durch die Gestaltung des Visieres gelang es Denfar, die gefürchteten Tentakel der Gedankenschinder davon abzuhalten, zu seinem Gehirn vorzudringen. Weiterhin fand er einen Weg, den intellektziehenden Fertigkeiten der Gedankenschinder entgegenzuwirken. Um ein Abnehmen des Helmes zu verhindern, belegte ihn Denfar mit einem Fluch. 
Letzten Endes wurde Denfar wie jeder seines Clans dennoch von den Gedankenschindern versklavt und starb einen qualvollen Tod, da es ihm verwehrt blieb, den Helm zum Trinken wieder abzunehmen. Denfar verdurstete zwei Monate nach seiner Gefangennahme mit der Erkenntnis, dass Gedankenschinder auch ohne das Verspeisen eines Gehirns grausame Foltermeister sind.

SPEZIFISCHE EIGENSCHAFTEN:

- Schützt vor den Tentakeln der Gedankenschinder 
- Schützt vor kritischen Treffern
- ETW0: -2 Malus
- Rettungswürfe: - 2 Malus
- Träger kann keine Zauber wirken, wenn der Helm getragen wird - weder Priester-, Magier- noch angeborene oder erworbene Zauber
- Fluch: Kann nur abgenommen werden, wenn vorher Fluch brechen gewirkt wurde.

Gewicht: 2~
@8089 = ~Zahnrad~
@8090 = ~Dieses Zahnrad scheint früher einen Mechanismus in Gang gehalten zu haben.~
@8091 = ~Adamant-Erz~
@8092 = ~Die leisen Stimmen der Wahrheit~
@8093 = ~Diese schlichte, ledergebundene Sammlung enthält uralte Lehrsprüche, Geschichten und Weisheiten, die Oghma, dem Herrn des Wissens, geweiht sind.

Die Seiten wirken unscheinbar, doch wer mit offenem Geist liest, erkennt zwischen den Zeilen eine tieferliegende Wahrheit, verborgen vor jenen, die nur mit den Augen suchen.

Ihr sollt das Buch zu Neeritha Runenschrift, der Oghma-Priesterin in Iltkazar, bringen.~
@8094 = ~Tensers fliegende Scheibe~
@8095 = ~Tensers fliegende Scheibe (Hervorrufung) 
Grad: 1
Reichweite: 0
Wirkungsdauer: 3 Runden
Zeitaufwand: 1
Wirkungsbereich: Der Zaubernde
Rettungswurf: Nein

Mit diesem Zauber erschafft der Zaubernde eine leicht konkave, kreisförmige Kraftebene, die als Tensers schwebende Scheibe bekannt ist (nach dem berühmten Zauberer, dessen Gier und Fähigkeit, Schätze zu finden, weithin bekannt sind). Die Scheibe hat einen Durchmesser von drei Fuß und hält ein Gewicht von 100 Pfund pro Stufe des Zaubernden. Die Scheibe schwebt etwa einen Meter über dem Boden und bleibt immer waagerecht. Auf Befehl des Zaubernden schwebt sie innerhalb ihrer Reichweite von 20 Metern entlang und bewegt sich mit einer Geschwindigkeit von maximal 6. Wenn der Zaubernde sich außerhalb der Reichweite bewegt (indem er sich schneller bewegt, z.B. durch einen Teleportationszauber), oder wenn die Dauer des Zaubers abläuft, verschwindet die schwebende Scheibe aus dem Dasein und alles, was sie getragen hat, stürzt auf die Oberfläche unter ihr.
Die Materialkomponente des Zaubers ist ein Tropfen Quecksilber.~
 
