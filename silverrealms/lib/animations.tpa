//APPEND ~animate.ids~ ~0x6801 SPRIGGAN~ UNLESS ~^0x6801~
//APPEND ~anisnd.ids~ ~0x6801 ¢TµT     CGAMEANIMATIONTYPE_SPRIGGAN~ UNLESS ~^0x6801~
END
*/
