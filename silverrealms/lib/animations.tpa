/*
COPY ~silverrealms/animations/copy_oBG2~         ~override~
// copy dracolich files
COPY ~silverrealms/animations/dracolich~    ~override~
//Patching IA's water elemental small death animation which otherwise leads to a crash
COPY_EXISTING ~µarsl.bam~   ~override/µarde.bam~
COPY_EXISTING ~µarsle.bam~   ~override/µardee.bam~

//Adding Acifers Rothé Animation
APPEND ~animate.ids~ ~0x533D NWN_ROTHE~ UNLESS ~^0x533[Dd]~
APPEND ~anisnd.ids~ ~0x533D µJW      CGAMEANIMATIONTYPE_NWN_ROTHE~ UNLESS ~^0x533[Dd]~
//Adding Acifers Gray Rothé Animation
APPEND ~animate.ids~ ~0x5101 NWN_ROTHE_GRAY~ UNLESS ~^0x5101~
APPEND ~anisnd.ids~ ~0x5101 µJX      CGAMEANIMATIONTYPE_NWN_ROTHE_GRAY~ UNLESS ~^0x5101~
// Adding Acifer NWN Bone Golem Animation
APPEND ~animate.ids~ ~0x5102 NWN_BONE_GOLEM~ UNLESS ~^0x5102~
APPEND ~anisnd.ids~ ~0x5102 µJY      CGAMEANIMATIONTYPE_NWN_BONE_GOLEM~ UNLESS ~^0x5102~
// Adding Acifer NWN Death Tyrant Animation
APPEND ~animate.ids~ ~0x5103 NWN_DEATH_TYRANT~ UNLESS ~^0x5103~
APPEND ~anisnd.ids~ ~0x5103 µJZ      CGAMEANIMATIONTYPE_NWN_DEATH_TYRANT~ UNLESS ~^0x5103~
// Adding Acifers NWN Raven Animation
APPEND ~animate.ids~ ~0x5341 NWN_RAVEN~ UNLESS ~^0x5341~
APPEND ~anisnd.ids~ ~0x5341 µKA      CGAMEANIMATIONTYPE_NWN_RAVEN~ UNLESS ~^0x5341~
// Adding Acifers NWN Allip Animation
APPEND ~animate.ids~ ~0x5342 NWN_ALLIP~ UNLESS ~^0x5342~
APPEND ~anisnd.ids~ ~0x5342 µKB      CGAMEANIMATIONTYPE_NWN_ALLIP~ UNLESS ~^0x5342~
// Adding Acifers Large Black Pudding Animation
APPEND ~animate.ids~ ~0x5587 ACIFER_BLACK_PUDDING~ UNLESS ~^0x5587~
APPEND ~anisnd.ids~ ~0x5587 £KJ      CGAMEANIMATIONTYPE_ACIFER_BLACK_PUDDING~ UNLESS ~^0x5587~
// Adding Cuvs PST True Shadow animation
APPEND ~animate.ids~ ~0x5110 PST_TRUE_SHADOW~ UNLESS ~^0x5110~
APPEND ~anisnd.ids~ ~0x5110 µKM      CGAMEANIMATIONTYPE_PST_TRUE_SHADOW~ UNLESS ~^0x5110~
// Adding Acifers Drowned_dead_small animation
APPEND ~animate.ids~ ~0x534e DROWNED_DEAD_SMALL~ UNLESS ~^0x534[Ee]~
APPEND ~anisnd.ids~ ~0x534e µKN      CGAMEANIMATIONTYPE_DROWNED_DEAD_SMALL~ UNLESS ~^0x534[Ee]~
// Adding Acifers Blacktroll Animation
APPEND ~animate.ids~ ~0x5343 ACIFER_BLACKTROLL~ UNLESS ~^0x5343~
APPEND ~anisnd.ids~ ~0x5343 µKC      CGAMEANIMATIONTYPE_ACIFER_BLACKTROLL~ UNLESS ~^0x5343~
// Adding Acifers Dretch Animation
APPEND ~animate.ids~ ~0x54AF ACIFER_DRETCH~ UNLESS ~^0x54[Aa][Ff]~
APPEND ~anisnd.ids~ ~0x54AF £CB      CGAMEANIMATIONTYPE_ACIFER_DRETCH~ UNLESS ~^0x54[Aa][Ff]~

// Adding Acifers huge earth elemental / Galeb Dhur animation
APPEND ~animate.ids~ ~0x510f IWD_EARTH_ELEMENTAL_HUGE~ UNLESS ~^0x510[Ff]~
APPEND ~anisnd.ids~ ~0x510f µKL      CGAMEANIMATIONTYPE_IWD_EARTH_ELEMENTAL_HUGE~ UNLESS ~^0x510[Ff]~
// Adding Acifers large Verbeeg animation
APPEND ~animate.ids~ ~0x5112 IWD_VERBEEG_LARGE~ UNLESS ~^0x5112~
APPEND ~anisnd.ids~ ~0x5112 µKO      CGAMEANIMATIONTYPE_IWD_VERBEEG_LARGE~ UNLESS ~^0x5112~
// Adding Gelugon Animation:
APPEND ~animate.ids~ ~0x5fe0 GELUGON_ACIFER~ UNLESS ~^0x5[Ff][Ee]0~
APPEND ~anisnd.ids~ ~0x5fe0 ØDY      CGAMEANIMATIONTYPE_GELUGON_ACIFER~ UNLESS ~^0x5[Ff][Ee]0~
// Adding Doomsphere Animation:
APPEND ~animate.ids~ ~0x5fe1 BEHOLDER_DOOMSPHERE~ UNLESS ~^0x5[Ff][Ee]1~
APPEND ~anisnd.ids~ ~0x5fe1 ØDZ      CGAMEANIMATIONTYPE_BEHOLDER_DOOMSPHERE~ UNLESS ~^0x5[Ff][Ee]1~
// Adding Earth whisper Animation:
APPEND ~animate.ids~ ~0x5fe2 EARTH_WHISPER~ UNLESS ~^0x5[Ff][Ee]2~
APPEND ~anisnd.ids~ ~0x5fe2 ØEA      CGAMEANIMATIONTYPE_EARTH_WHISPER~ UNLESS ~^0x5[Ff][Ee]2~
// Adding Hammer golem Animation:
APPEND ~animate.ids~ ~0x5113 HAMMER_GOLEM_PST~ UNLESS ~^0x5113~
APPEND ~anisnd.ids~ ~0x5113 µKP      CGAMEANIMATIONTYPE_HAMMER_GOLEM_PST~ UNLESS ~^0x5113~
// Adding Dracolich Animation:
APPEND ~animate.ids~ ~0x120e DRACOLICH~ UNLESS ~^0x120[Ee]~
APPEND ~anisnd.ids~ ~0x120e XDR6      CGAMEANIMATIONTYPE_DRACOLICH~ UNLESS ~^0x120[Ee]~
