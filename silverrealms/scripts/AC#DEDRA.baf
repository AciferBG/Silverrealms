   IF
  See([PC.GENERAL_ITEM.HUMAN])
  Global("REMOVEMAGIC","LOCALS",0)
THEN
  RESPONSE #100
    ForceSpell([INANIMATE.HUMANOID],DRAGON_STONE_SKIN)
    ForceSpell([PC.GENERAL_ITEM.HUMAN],WIZARD_DISPEL_MAGIC)
    SetGlobal("STONESKIN","LOCALS",1)
    SetGlobal("REMOVEMAGIC","LOCALS",1)
END

IF
  !Detect([PC])
  HPLT([INANIMATE.HUMANOID],50)
  CombatCounter(0)
THEN
  RESPONSE #100
    SetGlobal("REMOVEMAGIC","LOCALS",0)
    SetGlobal("WINGBUFFET","LOCALS",0)
    SetGlobal("HASTE","LOCALS",0)
    SetGlobal("DRAGONFEAR","LOCALS",0)
    ForceSpell([INANIMATE.HUMANOID],CLERIC_HEAL)
END

IF
  See([PC.GENERAL_ITEM.HUMAN])
  Global("DRAGONFEAR","LOCALS",0)
THEN
  RESPONSE #100
    ReallyForceSpell([PC.GENERAL_ITEM.HUMAN],DRAGON_FEAR)
    SetGlobal("DRAGONFEAR","LOCALS",1)
    SetGlobalTimer("SHADOWDRAGONBREATH","GLOBAL",1)
    ForceSpell([PC.GENERAL_ITEM.HUMAN],DRAGON_WING_BUFFET)
END

IF
  GlobalTimerExpired("SHADOWDRAGONBREATH","GLOBAL")
  See([PC.GENERAL_ITEM.HUMAN])
  Range([PC.GENERAL_ITEM.HUMAN],11)
  Global("WINGBUFFET","LOCALS",0)
THEN
  RESPONSE #100
    ForceSpell([PC.GENERAL_ITEM.HUMAN],DRAGON_WING_BUFFET)
    Wait(3)
    SetGlobal("WINGBUFFET","LOCALS",1)
    NoAction()
    Continue()
END

IF
  See([PC.GENERAL_ITEM.HUMAN])
  !Range([PC.GENERAL_ITEM.HUMAN],10)
  GlobalTimerExpired("SHADOWDRAGONBREATH","GLOBAL")
THEN
  RESPONSE #100
    SetGlobal("WINGBUFFET","LOCALS",0)
    ForceSpell([PC.GENERAL_ITEM.HUMAN],SHADOW_DRAGON_BREATH)
    SetGlobalTimer("SHADOWDRAGONBREATH","GLOBAL",THREE_ROUNDS)
END

IF
  See([PC.GENERAL_ITEM.HUMAN])
  Global("OFFENSIVE","LOCALS",0)
THEN
  RESPONSE #100
    ForceSpell([INANIMATE.HUMANOID],PROTECTION_MAGIC_WEAPON_NOEFF)
    SetGlobal("OFFENSIVE","LOCALS",2)
END

IF
  See([PC.GENERAL_ITEM.HUMAN])
  Global("OFFENSIVE","LOCALS",2)
THEN
  RESPONSE #100
    AttackOneRound([PC.GENERAL_ITEM.HUMAN])
    AttackOneRound([PC.GENERAL_ITEM.HUMAN])
    SetGlobal("OFFENSIVE","LOCALS",3)
END

IF
  See([PC.GENERAL_ITEM.HUMAN])
  Global("OFFENSIVE","LOCALS",3)
THEN
  RESPONSE #100
    ForceSpell([PC.GENERAL_ITEM.HUMAN],WIZARD_CHAOS)
    SetGlobal("OFFENSIVE","LOCALS",4)
END

IF
  See([PC.GENERAL_ITEM.HUMAN])
  Global("OFFENSIVE","LOCALS",4)
THEN
  RESPONSE #100
    ForceSpell([PC.GENERAL_ITEM.HUMAN],WIZARD_GREATER_MALISON)
    SetGlobal("OFFENSIVE","LOCALS",5)
END

IF
  See([PC.GENERAL_ITEM.HUMAN])
THEN
  RESPONSE #100
    EquipMostDamagingMelee()
    AttackReevaluate([PC.GENERAL_ITEM.HUMAN],35)
    NoAction()
    ForceSpell([PC.GENERAL_ITEM.HUMAN],WIZARD_CHROMATIC_ORB)
END

IF
  Allegiance([INANIMATE.HUMANOID],ENEMY)
  !See([0])
THEN
  RESPONSE #100
    MoveToObject([INANIMATE.21])
END

IF
  AttackedBy([GOODCUTOFF],DEFAULT)
  Allegiance([INANIMATE.HUMANOID],NEUTRAL)
THEN
  RESPONSE #100
    Enemy()
END

