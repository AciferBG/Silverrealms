IF
	Global("Prepared","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Prepared","LOCALS",1)
		ApplySpellRES("SPCL151",Myself) // Movement Rate Modifier
END

IF
	AttackedBy([ANYONE],DEFAULT)
	HPPercentLT(Myself,50)
	Global("Blurred","LOCALS",0)
THEN
	RESPONSE #100
		ReallyForceSpellRES("SPWI201",Myself)
		SetGlobal("Blurred","LOCALS",1)
END



