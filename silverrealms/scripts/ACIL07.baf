IF
	Global("EnteredArea","ACIL07",0)
THEN
	RESPONSE #100
		SetGlobal("EnteredArea","ACIL07",1)
		SetGlobal("AC#Been_in_ACIL07","GLOBAL",1)
		TriggerActivation("Tran0020",FALSE)
		Explore()
END

