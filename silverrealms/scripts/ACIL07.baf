IF
	Global("AC#DragonToy","GLOBAL",10)
THEN
	RESPONSE #100
		SetGlobal("AC#DragonToy","GLOBAL",11)
		ActionOverride("Dead_boy",CreateItem("AC#S#DRR",0,0,0))  // Dragon Toy
END


