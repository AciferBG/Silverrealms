IF
	Global("EnteredArea","ACIL89",0)
THEN
	RESPONSE #100
		SetMusic(NIGHT,%AC#IL56%)
		SetMusic(DAY,%AC#IL56%)		
		SetGlobal("EnteredArea","ACIL89",1)	
END

