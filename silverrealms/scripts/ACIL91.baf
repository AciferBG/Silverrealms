IF
  Global("WayOut","ACIL91",0)
  //Global("Disc_Orientation","ACIL91",0)
  Global("AC#IL91WayOut","GLOBAL",1)
  //OpenState("DOOR02",TRUE)
THEN
    RESPONSE #100
    SetGlobal("WayOut","ACIL91",1)
    OpenDoor("DOOR01")
    AddExperienceParty(500)
    //EraseJournalEntry(@90013)
    AddJournalEntry(@90011,QUEST)
END

