IF
	OR(2)
	Global("AC#BeldasPlotStart","GLOBAL",0)
	Global("AC#BeldasPlotStart","GLOBAL",2)
THEN
	RESPONSE #100
		SetGlobal("AC#BeldasPlotStart","GLOBAL",3)
