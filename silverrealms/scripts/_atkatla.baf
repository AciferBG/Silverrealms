// The messenger apperas in athkatla and delivers a note from beldas

IF
	InMyArea(Player1)
	Global("AC#BeldasPlotStart","GLOBAL",0)
	AreaType(OUTDOOR)
THEN
	RESPONSE #100
		SetGlobal("AC#BeldasPlotStart","GLOBAL",1)
		CreateCreatureObjectOffScreen("AC#S#MS1",Player1,0,0,0) // Bote
		ActionOverride("AC#S#MS1",Dialogue([PC]))
END



