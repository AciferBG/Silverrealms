IF
	Global("AC#_HatharCombat","ACIL20",2)
	Global("AC#_IltkazarGates","ACIL20",0)
THEN
	RESPONSE #100
		SetGlobal("AC#_IltkazarGates","ACIL20",1)
                ClearAllActions()
		StartCutSceneMode()
		MoveViewPoint([3479.384],100)
		CreateCreature("CUTSPY",[3479.384],11)
		Wait(2)
		OpenDoor("DOOR02")
		Wait(1)
		ActionOverride("CUTSPY",DestroySelf())
		EndCutSceneMode()
END

