// after talk to Maldraedior
// transform Iltkazar to siege status: deactivate area ACIL50; temporaryly activate Area ACIL66 until azerkyn hall is destroyed
IF
	GlobalGT("AC#Talked_to_Maldraedior","GLOBAL",0)
	Global("Deactivate_Travel","ACIL20",0)
THEN
	RESPONSE #100
		SetGlobal("Deactivate_Travel","ACIL20",1)
		TriggerActivation("Tracil50",FALSE)
		TriggerActivation("Tracil66",TRUE)
		ActionOverride("AC#HATH1",Activate(Myself))
END

// after talk to Maldraedior
