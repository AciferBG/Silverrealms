END

IF
	Global("Wheres_Cleric","ACIL20",1)
THEN
	RESPONSE #100
		//SmallWait(15)
		ActionOverride("AC#20DW9",StartDialogNoSet(Player1))
END

IF
	Global("ClearPassage","ACIL20",1)
THEN
	RESPONSE #100
		Wait(1)
		ClearAllActions()
		StartCutSceneMode()
		ActionOverride("AC#20DW9",ForceSpell(Myself,DO_NOTHING))
		Wait(2)
		FadeToColor([20.0],0)
		Wait(2)
		OpenDoor("DOOR05")
		CreateCreature("AC#20KDD",[4122.2595],0)  // dead kuo toa
		CreateCreature("AC#20KDD",[4118.2598],3)  // dead kuo toa
		CreateCreature("AC#20KDD",[4053.2578],13)  // dead kuo toa
		CreateCreature("AC#20KDD",[4089.2610],6)  // dead kuo toa
		FadeFromColor([20.0],0)
		EndCutSceneMode()
		SetGlobal("ClearPassage","ACIL20",10)
		ActionOverride("AC#HATH1",StartDialogNoSet(Player1))
END

IF
	Global("Acil20_DrowPriestess","ACIL20",0)
	Global("AC#BreskDrowPriestess","GLOBAL",3)
THEN
	RESPONSE #100
        SetGlobal("Acil20_DrowPriestess","ACIL20",1)
