IF
	Global("LakeEntrySealed","ACIL20",0)
	GlobalGT("AC#RC_Sorni_Fourth","GLOBAL",0) // Quest: Check for boats started
THEN
	RESPONSE #100
        SetGlobal("LakeEntrySealed","ACIL20",1)
		CloseDoor("DOOR05") // stone blocks to area ACIL27
