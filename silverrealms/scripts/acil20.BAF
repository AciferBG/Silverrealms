	Global("AC#HatharQuest","GLOBAL",2)
THEN
	RESPONSE #100
		SetGlobal("AC#HatharQuest","GLOBAL",3)
		CreateCreature("AC#ABDE1",[3268.658],8)
		CreateCreature("AC#ABDE1",[3260.650],12)
		CreateCreature("DEADDEM1",[3272.663],1)
