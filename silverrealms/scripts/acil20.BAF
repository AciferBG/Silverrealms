IF
	Global("AC#Goodbye_Iltkazar","GLOBAL",6)
THEN
	RESPONSE #100
		//SetGlobal("AC#Goodbye_Iltkazar","GLOBAL",10)
                ClearAllActions()
		StartCutSceneMode()
		FadeToColor([15.0],0)
 	        ActionOverride("AC#BRES9",EscapeArea())
 	        ActionOverride("AC#GROM9",EscapeArea())
 	        ActionOverride("AC#DUN20",EscapeArea())
 	        ActionOverride("AC#ELER9",EscapeArea())
 	        ActionOverride("AC#SORN9",EscapeArea())
 	        ActionOverride("AC#VRON9",EscapeArea())
 	        ActionOverride("AC#ANT20",EscapeArea())
 	        ActionOverride("AC#TURB9",EscapeArea())
 	        ActionOverride("AC#HATH1",Deactivate(Myself))
 	        Wait(2)
		//Wait(5)
		CloseDoor("DOOR02")
		Wait(1)
		Lock("DOOR02")
		FadeFromColor([30.0],150)
		Wait(1)
		SetGlobal("AC#Goodbye_Iltkazar","GLOBAL",10)
		EndCutSceneMode()
END

IF
	Global("AC#Goodbye_Iltkazar","GLOBAL",10)
	Global("AC#_Iltkazar_Destroyed","GLOBAL",0)
	Global("Door02ClosedDuergar","ACIL20",0)
	OpenState("DOOR02",TRUE)
THEN
	RESPONSE #100
		SetGlobal("Door02ClosedDuergar","ACIL20",1)
		CloseDoor("DOOR02")
		Lock("DOOR02")
END

