		CreateCreature("AC#20DW8",[3794.2445],5) // dwarven Warrior
		CreateCreature("AC#20DW8",[3769.2474],5) // dwarven Warrior
		CreateCreature("AC#20DW8",[3783.2524],5) // dwarven Warrior
