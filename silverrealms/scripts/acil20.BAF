		CreateCreature("AC#DROW3",[1166.951],0)  // Drow Priestess
		CreateCreature("AC#DROW5",[1118.987],5) // Drow Warrior
		CreateCreature("AC#DROW5",[1205.1003],13) // Drow Warrior
		CreateCreature("AC#DROW5",[1112.826],9) // Drow Warrior
		CreateCreature("AC#DROW4",[1134.877],1)  // Drow Wizard
END

IF
	Global("Acil20_DrowPriestess","ACIL20",1)
	PartyHasItem("AC#DROHE") // head of the drow priestess
THEN
	RESPONSE #100
        SetGlobal("Acil20_DrowPriestess","ACIL20",2)
		SpawnPtActivate("Hook Horror") //  activate  Hook Horror Spawn when drow priestess is dead
		EraseJournalEntry(@50020)
		AddJournalEntry(@50021,QUEST)
END

