/*
Textscreen: Die PCs werden nach unten gelassen
*/
IF
	Global("EnteredArea","ACIL57",0)
THEN
	RESPONSE #100
		FadeToColor([0.0],0)
		SetGlobal("EnteredArea","ACIL57",1)
		SetMusic(NIGHT,%AC#IL57%)
		SetMusic(DAY,%AC#IL57%)	
		StartMovie("ac#57mve")
		// TextScreen("AC#MOS57")
END

/*
Die PCs schlagen auf dem Boden auf und werden von einer Horde Zombies attakiert
*/

IF
	Global("EnteredArea","ACIL57",1)
THEN
	RESPONSE #100
                 ClearAllActions()
                 SetGlobal("EnteredArea","ACIL57",2)
		ActionOverride(Player1,PlayDead(35))
		ActionOverride(Player2,PlayDead(35))
		ActionOverride(Player3,PlayDead(35))
		ActionOverride(Player4,PlayDead(35))
		ActionOverride(Player5,PlayDead(35))
		ActionOverride(Player6,PlayDead(35))
		ApplyDamage(Player1,1,CRUSHING)
		ApplyDamage(Player2,1,CRUSHING)
		ApplyDamage(Player3,1,CRUSHING)
                ApplyDamage(Player4,1,CRUSHING)
                ApplyDamage(Player5,1,CRUSHING)
                ApplyDamage(Player6,1,CRUSHING)
		CreateCreature("ZOMBIE01",[440.2343],6)
		CreateCreature("ZOMBIE01",[449.2360],11)
		Wait(2)
		ScreenShake([50.50],15)
		ActionOverride("AC#SKAR1",Shout(89))
		FadeFromColor([30.0],0)
END

IF
	Global("EnteredArea","ACIL57",2)
THEN
	RESPONSE #100
		SetGlobal("EnteredArea","ACIL57",3)
                AmbientActivate("Steam01",FALSE)
                AmbientActivate("Steam02",FALSE)
                SoundActivate("Steamsound01",FALSE)
                SoundActivate("Steamsound02",FALSE)
END

IF
	OpenState("DOOR09",TRUE)
        OpenState("DOOR10",TRUE)
        OpenState("DOOR08",FALSE)
        Global("DOOR08","ACIL57",0)

THEN
	RESPONSE #100
	         SetGlobal("DOOR08","ACIL57",1)
		DisplayString(Myself,@683)  // ~Irgendwo hat sich eine T�r ge�ffnet.~
                OpenDoor("DOOR08")
                ActionOverride("AC#DURG2",DestroySelf())
                TriggerActivation("AC#57TR1",FALSE)
END

IF
	//PartyHasItem("AC#HADUM")
	Global("Info_Hammer_Doors","ACIL57",0)
	OR(6)
	HasItem("AC#HADUM",Player1)
	HasItem("AC#HADUM",Player2)
	HasItem("AC#HADUM",Player3)
	HasItem("AC#HADUM",Player4)
	HasItem("AC#HADUM",Player5)
	HasItem("AC#HADUM",Player6)
THEN
	RESPONSE #100
                DisplayStringHeadOwner("AC#HADUM",@679) // ~Der Hammer Dumathoins pulsiert pl�tzlich in einem starhlenden Licht. Ihr k�nnt mit seiner Macht die bisher verschlossenen T�ren �ffnen.~
                SetGlobal("Info_Hammer_Doors","ACIL57",1)
END
