// not needed anymore: driftdisc is aquired earlier
/*
IF
	Clicked([ANYONE])
	Range(LastTrigger,15)
	GlobalLT("AC#Goodbye_Iltkazar","GLOBAL",10)
	GlobalGT("AC#Clans_Parting","GLOBAL",0)
	GlobalGT("AC#BackToSurface","GLOBAL",0)
	Global("AC#Driftdisc","ACIL21",1)
THEN
