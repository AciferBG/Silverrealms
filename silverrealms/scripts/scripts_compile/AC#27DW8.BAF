IF
    Global("AidDwarves","ACIL27",1)
    Global("ChangeAI","LOCALS",0)
    Allegiance(Myself,NEUTRAL)
THEN
    RESPONSE #100
        ChangeEnemyAlly(Myself,GOODBUTBLUE)
        SetGlobal("ChangeAI","LOCALS",1)
END

IF
    See([ENEMY])
THEN
    RESPONSE #100
        AttackReevaluate(NearestEnemyOf(Myself),12)
END

IF
    Global("AidDwarves","ACIL27",2)
    !See([ENEMY])
    !Range(Player1,12)
    Delay(6)
THEN
    RESPONSE #100
        MoveToObject(Player1)
END

