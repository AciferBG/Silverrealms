IF
    See(NearestEnemyOf(Myself))
    Global("Preparation","LOCALS",0)
THEN
    RESPONSE #100
        ApplySpell(Myself,CLERIC_IRONSKIN)  // SPPR506.SPL (Eisenhaut)
        ApplySpell(Myself,CLERIC_PHYSICAL_MIRROR)  // SPPR613.SPL (Materiespiegel)
        ReallyForceSpell(LastSeenBy(Myself),CLERIC_DEFENSIVE_HARMONY)  // SPPR406.SPL (Koordinierte Verteidigung)
        SetGlobal("Preparation","LOCALS",1)
END

IF
    !GlobalTimerNotExpired("TrueSeeing","LOCALS")
    Detect(NearestEnemyOf(Myself))
    OR(12)
        StateCheck(NearestEnemyOf(Myself),STATE_INVISIBLE)
        StateCheck(NearestEnemyOf(Myself),STATE_IMPROVEDINVISIBILITY)
        StateCheck(SecondNearestEnemyOf(Myself),STATE_INVISIBLE)
        StateCheck(SecondNearestEnemyOf(Myself),STATE_IMPROVEDINVISIBILITY)
        StateCheck(ThirdNearestEnemyOf(Myself),STATE_INVISIBLE)
        StateCheck(ThirdNearestEnemyOf(Myself),STATE_IMPROVEDINVISIBILITY)
        StateCheck(FourthNearestEnemyOf(Myself),STATE_INVISIBLE)
        StateCheck(FourthNearestEnemyOf(Myself),STATE_IMPROVEDINVISIBILITY)
        StateCheck(FifthNearestEnemyOf(Myself),STATE_INVISIBLE)
        StateCheck(FifthNearestEnemyOf(Myself),STATE_IMPROVEDINVISIBILITY)
        StateCheck(SixthNearestEnemyOf(Myself),STATE_INVISIBLE)
        StateCheck(SixthNearestEnemyOf(Myself),STATE_IMPROVEDINVISIBILITY)
THEN
    RESPONSE #100
        SetGlobalTimer("TrueSeeing","LOCALS",TEN_ROUNDS)
        SpellNoDec(Myself,CLERIC_TRUE_SIGHT)  // SPPR505.SPL (Wahrer Blick)
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpellRES("AC#IL28")  // Erdelementar beschwören
THEN
    RESPONSE #100
        SpellRES("AC#IL28",NearestEnemyOf(Myself))  // Erdelementar beschwören
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(NPC_BLADE_BARRIER)  // SPPR698.SPL (Klingenbarierre)
    Global("BladeBarrier","LOCALS",0)
THEN
    RESPONSE #100
        Spell(Myself,NPC_BLADE_BARRIER)  // SPPR698.SPL (Klingenbarierre)
        SetGlobal("BladeBarrier","LOCALS",1)
END

IF
    See(NearestEnemyOf(Myself))
    HitBy([ANYONE],CRUSHING)
    HaveSpell(CLERIC_IRONSKIN)  // SPPR506.SPL (Eisenhaut)
THEN
    RESPONSE #100
        Spell(Myself,CLERIC_IRONSKIN)  // SPPR506.SPL (Eisenhaut)
END

IF
    See(NearestEnemyOf(Myself))
    RandomNum(2,1)
    HaveSpell(CLERIC_FINGER_OF_DEATH)  // SPPR708.SPL (Finger des Todes)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),CLERIC_FINGER_OF_DEATH)  // SPPR708.SPL (Finger des Todes)
END

IF
    See(NearestEnemyOf(Myself))
    RandomNum(2,2)
    HaveSpell(CLERIC_INSECT_PLAGUE)  // SPPR517.SPL (Insektenplage)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),CLERIC_INSECT_PLAGUE)  // SPPR517.SPL (Insektenplage)
END

IF
    See(NearestEnemyOf(Myself))
    RandomNum(2,1)
    HaveSpell(CLERIC_CONFUSION)  // SPPR709.SPL (Verwirrung)
THEN
    RESPONSE #100
        Spell(Myself,CLERIC_CONFUSION)  // SPPR709.SPL (Verwirrung)
END

IF
    See(NearestEnemyOf(Myself))
    RandomNum(2,1)
    HaveSpell(CLERIC_AERIAL_SERVANT)  // SPPR601.SPL (Luftdiener)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),CLERIC_AERIAL_SERVANT)  // SPPR601.SPL (Luftdiener)
END

IF
    HaveSpell(CLERIC_SILENCE_15_FOOT)  // SPPR211.SPL (Stille: 4,5 m Radius)
    OR(2)
        See(NearestEnemyOfType([0.0.0.MAGE_ALL]))
        See(NearestEnemyOfType([0.0.0.CLERIC_ALL]))
THEN
    RESPONSE #100
        Spell(LastSeenBy(Myself),CLERIC_SILENCE_15_FOOT)  // SPPR211.SPL (Stille: 4,5 m Radius)
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(CLERIC_FLAME_STRIKE)  // SPPR503.SPL (Flammenschlag)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),CLERIC_FLAME_STRIKE)  // SPPR503.SPL (Flammenschlag)
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(CLERIC_HOLD_PERSON)  // SPPR208.SPL (Personen festhalten)
    !StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),CLERIC_HOLD_PERSON)  // SPPR208.SPL (Personen festhalten)
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(CLERIC_CLOAK_OF_FEAR)  // SPPR416.SPL (Mantel der Furcht)
THEN
    RESPONSE #100
        Spell(Myself,CLERIC_CLOAK_OF_FEAR)  // SPPR416.SPL (Mantel der Furcht)
END

IF
    See(NearestEnemyOf(Myself))
    Range(NearestEnemyOf(Myself),7)
THEN
    RESPONSE #100
        EquipMostDamagingMelee()
        AttackReevaluate(NearestEnemyOf(Myself),45)
END

