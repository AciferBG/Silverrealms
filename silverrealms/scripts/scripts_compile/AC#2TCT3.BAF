IF
    True()
THEN
    RESPONSE #100
        CutSceneId(Player1)
        LeaveAreaLUAPanic("ACIL2T","",[6.948],S)
        LeaveAreaLUA("ACIL2T","",[6.948],NW)
        MultiPlayerSync()
        MoveViewPoint([1539.1297],INSTANT)
        CreateCreature("AC#4TTIA",[480.306],NW)  // Tiamat
        CreateCreature("AC#MAL4T",[847.761],NW)  // Malphas
        ActionOverride("AC#MAL4T",MoveToPoint([600.499]))
        MoveViewPoint([480.306],100)
