IF
	True()
THEN
	RESPONSE #100
		CutSceneId("AC#MAL06")  // Malphas
		ReallyForceSpellPointRES("AC#CTMSW",[200.200])  // Meteorschwarm
		ActionOverride("AC#ALDYM",ChangeAnimationNoEffect("AC#ALDY2"))  // Aldym Ryscelsar
		ActionOverride(Player1,PlayDead(160))
		ActionOverride(Player2,PlayDead(160))
		ActionOverride(Player3,PlayDead(160))
		ActionOverride(Player4,PlayDead(160))
		ActionOverride(Player5,PlayDead(160))
		ActionOverride(Player6,PlayDead(160))
		ScreenShake([20.20],10)
		Wait(2)
		SetGlobal("AC#_Malphas_Revealed","GLOBAL",2)
		SmallWait(5)
		EndCutSceneMode()
END



