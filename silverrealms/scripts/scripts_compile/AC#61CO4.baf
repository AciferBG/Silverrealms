IF
	Contains("ac#antr1",Myself)
	GlobalLT("AC#_Destroy_Oven","ACIL61",3)
THEN
	RESPONSE #100
                SetInterrupt(FALSE)
                DestroyItem("ac#antr1")
		PlaySound("EFF_P92")
		ScreenShake([20.20],5)
		CreateVisualEffectObject("ICMAGICH",Myself)
		Wait(2)
		DisplayString(Myself,@108)
		AmbientActivate("Furnace03",TRUE)
		//AmbientActivate("Fieryoven04a",TRUE)
		SoundActivate("Firesound04",TRUE)
		ContainerEnable("AC#61CO4",FALSE)
		IncrementGlobal("AC#_Destroy_Oven","ACIL61",1)
		SetInterrupt(TRUE)
END
