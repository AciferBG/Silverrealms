IF
	AttackedBy([PC],DEFAULT)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@938)
END

IF
	Global("AC#Goapspawn","GLOBAL",2)
THEN
	RESPONSE #100
		MoveToObject("AC#DUN02")  // Dunnabar Steinschulter
END

IF
	Exists("AC#GOAP1")  // Goap
	!See("AC#GOAP1")  // Goap
	!See(NearestEnemyOf(Myself))
	ActionListEmpty()
THEN
	RESPONSE #100
		MoveToObject("AC#GOAP1")  // Goap
END

IF
	Heard([ANYONE],153)
	InMyGroup(LastHeardBy(Myself))
THEN
	RESPONSE #100
		AttackReevaluate(LastAttackerOf(LastHeardBy(Myself)),30)
END

IF
	General(Myself,HUMANOID)
	BreakingPoint()
	Global("Panic","LOCALS",0)
THEN
	RESPONSE #50
		SetGlobal("Panic","LOCALS",1)
		DisplayStringHead(Myself,49766)  // Das ist mir zuviel!
	RESPONSE #50
		SetGlobal("Panic","LOCALS",1)
		DisplayStringHead(Myself,49767)  // Nein, h�rt auf.
	RESPONSE #50
		SetGlobal("Panic","LOCALS",1)
		DisplayStringHead(Myself,49768)  // Gnade!
END

IF
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		AttackReevaluate(NearestEnemyOf(Myself),30)
END

IF
	!See([ENEMY])
THEN
	RESPONSE #100
		RandomWalk()
END

