IF
	Clicked([ANYONE])
	OR(2)
		Race(LastTrigger,ELF)
		Race(LastTrigger,HALF_ELF)
THEN
	RESPONSE #100
		DisplayString(Myself,@946)
END

IF
	Clicked([ANYONE])
	CheckStatGT(LastTrigger,70,LORE)

THEN
	RESPONSE #100
		DisplayString(Myself,@946)
END

IF
	Clicked([ANYONE])
	CheckStatLT(LastTrigger,71,LORE)

THEN
	RESPONSE #100
		DisplayString(Myself,@947)
END

