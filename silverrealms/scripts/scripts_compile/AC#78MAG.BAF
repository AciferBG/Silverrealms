	See(NearestEnemyOfType([0.0.0.MAGE_ALL]))
	HaveSpell(WIZARD_PIERCE_MAGIC)  // SPWI608.SPL (Magie durchdringen)
	HaveSpell(WIZARD_POWER_WORD_SILENCE)  // SPWI612.SPL (Wort der Macht: Stille)
