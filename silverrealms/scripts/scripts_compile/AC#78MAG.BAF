	See([GOODCUTOFF.0.0.0.0.SUMMONED])
	Range(LastSeenBy(Myself),12)
	HaveSpell(WIZARD_MINOR_GLOBE_OF_INVULNERABILITY)  // SPWI406.SPL (Kleinere Kugel der Unverwundbarkeit)
THEN
