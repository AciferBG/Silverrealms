IF
	Global("prepspells","LOCALS",0)
	See(NearestEnemyOf(Myself))
	See(NearestMyGroupOfType)
THEN
	RESPONSE #100
		SetGlobal("prepspells","LOCALS",1)
		ForceSpell(Myself,WIZARD_MISLEAD)  // SPWI607.SPL (Ablenkung)
		DisplayString(Myself,31247)  // Tattoo der Macht: Immunität gegen Zauber
		ApplySpell(Myself,WIZARD_SPELL_IMMUNITY_INVOCATION)  // SPWI595.SPL (Immunität gegen Zauber: Hervorrufung)
		Spell(LastSeenBy(Myself),WIZARD_HASTE)  // SPWI305.SPL (Hast)
END

IF
	Allegiance(Myself,ENEMY)
	See([GOODCUTOFF.0.0.0.0.SUMMONED])
	!Range(LastSeenBy(Myself),12)
	HaveSpell(WIZARD_DISPEL_MAGIC)  // SPWI302.SPL (Magie bannen)
	Global("DeathSpell","LOCALS",0)
THEN
	RESPONSE #100
		DisplayString(Myself,31024)  // Magisches Tattoo: Spiegelbild
		ApplySpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Spiegelbild)
		ForceSpell(LastSeenBy(Myself),WIZARD_DEATH_SPELL)  // SPWI605.SPL (Todeszauber)
		SetGlobal("DeathSpell","LOCALS",1)
END

IF
	Allegiance(Myself,ENEMY)
	Global("prepspells","LOCALS",1)
	CheckStatLT(Myself,1,STONESKINS)
	TookDamage()
THEN
	RESPONSE #100
		DisplayString(Myself,29736)  // Notfall: Steinhaut
		ApplySpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Steinhaut)
		SetGlobal("prepspells","LOCALS",2)
END

IF
	Allegiance(Myself,ENEMY)
	See(StrongestOf([PC]))
	HaveSpell(WIZARD_MAZE)  // SPWI813.SPL (Irrgarten)
THEN
	RESPONSE #100
		Spell(LastSeenBy(Myself),WIZARD_MAZE)  // SPWI813.SPL (Irrgarten)
END

IF
	See(NearestEnemyOf(Myself))
	HaveSpell(WIZARD_GREATER_MALISON)  // SPWI412.SPL (Größeres Unbehagen)
	HaveSpell(WIZARD_CHAOS)  // SPWI508.SPL (Chaos)
THEN
	RESPONSE #100
		Spell(SecondNearestEnemyOf(Myself),WIZARD_GREATER_MALISON)  // SPWI412.SPL (Größeres Unbehagen)
		Spell(SecondNearestEnemyOf(Myself),WIZARD_CHAOS)  // SPWI508.SPL (Chaos)
END

