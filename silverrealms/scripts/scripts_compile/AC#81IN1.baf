IF
	Clicked([ANYONE])
	Global("Info_Energybarrier","ACIL81",0)
THEN
	RESPONSE #100
                SetGlobal("Info_Energybarrier","ACIL81",1)
		DisplayString(Myself,@156)
END

IF
	Clicked([ANYONE])
	Global("Info_Energybarrier","ACIL81",1)
THEN
	RESPONSE #100
                SetGlobal("Info_Energybarrier","ACIL81",2)
		DisplayString(Myself,@157)
END

IF
	Clicked([ANYONE])
	!Range(LastTrigger,10)
THEN
	RESPONSE #100
		DisplayString(Myself,14702)
END

