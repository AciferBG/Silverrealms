IF
    Clicked([ANYONE])
    Range(LastTrigger,25)
THEN
    RESPONSE #100
        ActionOverride("AC#95MAP",StartDialogueNoSet([PC]))
END

IF
    Clicked([ANYONE])
    !Range(LastTrigger,25)
THEN
    RESPONSE #100
        DisplayString(Myself,14702)  // Ihr seid zu weit entfernt, um das zu benutzen.
END

