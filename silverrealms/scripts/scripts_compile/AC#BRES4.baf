IF
	NumTimesTalkedTo(0)
	Detect([PC])
THEN
	RESPONSE #100
		StartDialogNoSet(LastSeenBy(Myself))
END

IF
	PartyHasItem("AC#67POT")  // Schmelztiegel
	Detect([PC])
	Range([PC],20)
	Global("RescuePot","ACIL67",0)
THEN
	RESPONSE #100
		SetGlobal("RescuePot","ACIL67",1)
		StartDialogNoSet(LastSeenBy(Myself))
END

