IF
	NumTimesTalkedTo(0)
THEN
	RESPONSE #100
		StartDialogNoSet("AC#MAL03")  // Malphas
END

IF
	OR(3)
		See(NearestEnemyOf(Myself))
		Global("SkeletonFight","ACIL80",1)
		Heard([ANYONE],89)
	Global("SkeletonFight","ACIL80",1)
THEN
	RESPONSE #100
		ApplySpell(Myself,CLERIC_REGENERATE)  // SPPR711.SPL (Regeneration)
		ApplySpell(Myself,CLERIC_DEATH_WARD)  // SPPR409.SPL (Todesschutz)
		ReallyForceSpell(LastSeenBy(Myself),CLERIC_DEFENSIVE_HARMONY)  // SPPR406.SPL (Koordinierte Verteidigung)
		MoveToPoint([2588.542])
		SetGlobal("SkeletonFight","ACIL80",2)
END

IF
	!See(NearestEnemyOf(Myself))
	Heard([ANYONE],89)
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END

IF
	AttackedBy([ANYONE],RANGED)
	HaveSpell(CLERIC_PHYSICAL_MIRROR)  // SPPR613.SPL (Materiespiegel)
THEN
	RESPONSE #100
		Spell(Myself,CLERIC_PHYSICAL_MIRROR)  // SPPR613.SPL (Materiespiegel)
END

IF
	Detect(NearestEnemyOf(Myself))
	OR(5)
		!See(NearestEnemyOf(Myself))
		StateCheck(NearestEnemyOf(Myself),STATE_IMPROVEDINVISIBILITY)
		StateCheck(NearestEnemyOf(Myself),STATE_MIRRORIMAGE)
		StateCheck(NearestEnemyOf(Myself),STATE_BLUR)
		Gender(NearestEnemyOf(Myself),ILLUSIONARY)
	HaveSpell(CLERIC_TRUE_SIGHT)  // SPPR505.SPL (Wahrer Blick)
THEN
	RESPONSE #100
		Spell(Myself,CLERIC_TRUE_SIGHT)  // SPPR505.SPL (Wahrer Blick)
END

IF
	OR(2)
		See([GOODCUTOFF.0.SKELETON])
		See([CONTROLLED.0.SKELETON])
	!GlobalTimerNotExpired("TurnUndead","LOCALS")
THEN
	RESPONSE #100
		Turn()
		SetGlobalTimer("TurnUndead","LOCALS",TWO_ROUNDS)
END

IF
	See(NearestEnemyOfType([0.0.0.CLERIC_ALL]))
	HaveSpell(CLERIC_CONFUSION)  // SPPR709.SPL (Verwirrung)
	!Race(LastSeenBy(Myself),SKELETON)
THEN
	RESPONSE #100
		Spell(LastSeenBy(Myself),CLERIC_CONFUSION)  // SPPR709.SPL (Verwirrung)
END

