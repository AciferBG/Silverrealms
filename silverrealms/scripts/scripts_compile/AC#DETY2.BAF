THEN
    RESPONSE #100
        FaceObject(LastSeenBy(Myself))
        ForceSpell(LastSeenBy(Myself),BEHOLDER_PARALYZATION)  // SPIN990.SPL (Lähmung)
        Wait(3)
        Continue()
END

IF
    Global("BeholderBehavior","LOCALS",1)
    See([PC])
    HPGT(Myself,35)
THEN
    RESPONSE #100
        FaceObject(SecondNearest([PC]))
        ForceSpell(SecondNearest([PC]),BEHOLDER_SLOW)  // SPIN983.SPL (Verlangsamen)
        Wait(2)
        Continue()
END

IF
    Global("BeholderBehavior","LOCALS",1)
    See([PC])
    HPGT(Myself,5)
THEN
    RESPONSE #100
        FaceObject(ThirdNearest([PC]))
        ForceSpell(LeastDamagedOf(Myself),HIVE_MOTHER_CAUSE_SERIOUS_WOUNDS)  // SPIN551.SPL (Schwere Wunden verursachen)
        Wait(2)
        Continue()
END

IF
    OR(2)
        LevelGT(Player1,11)
        DifficultyGT(NORMAL)
    Global("BeholderBehavior","LOCALS",1)
    See(LeastDamagedOf(Myself))
THEN
    RESPONSE #100
        FaceObject(LeastDamagedOf(Myself))
        ForceSpell(LeastDamagedOf(Myself),BEHOLDER_DEATH_RAY)  // SPIN991.SPL (Todesstrahl)
        Continue()
END

IF
    OR(2)
        LevelGT(Player1,11)
        DifficultyGT(NORMAL)
    Global("BeholderBehavior","LOCALS",1)
    See([PC])
    !See(LeastDamagedOf(Myself))
THEN
    RESPONSE #100
        FaceObject([PC])
        ForceSpell([PC],BEHOLDER_DEATH_RAY)  // SPIN991.SPL (Todesstrahl)
        Continue()
END

IF
    Global("BeholderBehavior","LOCALS",1)
    See([PC])
    See([PC.0.0.MAGE])
THEN
    RESPONSE #100
        FaceObject(LastSeenBy(Myself))
        ForceSpell(LastSeenBy(Myself),BEHOLDER_ANTIMAGIC_RAY)  // SPIN992.SPL (Antimagischer Strahl)
        SetGlobal("BeholderBehavior","LOCALS",0)
        Wait(2)
END

IF
    Global("BeholderBehavior","LOCALS",1)
    See([PC])
    !See([PC.0.0.MAGE])
THEN
    RESPONSE #100
        FaceObject([PC])
        ForceSpell([PC],BEHOLDER_ANTIMAGIC_RAY)  // SPIN992.SPL (Antimagischer Strahl)
        SetGlobal("BeholderBehavior","LOCALS",0)
