IF
    GlobalGT("AC#25_LolthPriestess","GLOBAL",2)
    Global("AC#25PactLolthPriestess","GLOBAL",0)
THEN
    RESPONSE #100
        CreateVisualEffectObject("SPDIMNDR",Myself)
        Wait(1)
        DestroySelf()
END

IF
    Global("AC#25PactLolthPriestess","GLOBAL",10)
THEN
    RESPONSE #100
        CreateVisualEffectObject("SPDIMNDR",Myself)
        Wait(1)
        DestroySelf()
END

IF
    Allegiance(Myself,ENEMY)
    See(NearestEnemyOf(Myself))
    See(SixthNearest([GOODCUTOFF]))
    Global("Ambush06","LOCALS",0)
THEN
    RESPONSE #100
        SetGlobal("Ambush06","LOCALS",1)
        CreateCreatureObjectEffect("AC#DROW7","AC#ILSH2",SixthNearest([GOODCUTOFF]))  // Drow
        Continue()
END

