IF
    GlobalGT("AC#25_LolthPriestess","GLOBAL",2)
    Global("AC#25PactLolthPriestess","GLOBAL",0)
THEN
    RESPONSE #100
        CreateVisualEffectObject("SPDIMNDR",Myself)
        Wait(1)
        DestroySelf()
END

