IF
    Clicked([ANYONE])
    Range(LastTrigger,10)
    Global("GithruneCutscene","ACIL20",0)
THEN
    RESPONSE #100
        SetGlobal("GithruneCutscene","ACIL20",1)
END

IF
    Clicked([ANYONE])
    !Range(LastTrigger,10)
THEN
    RESPONSE #100
        DisplayString(Myself,14702)  // Ihr seid zu weit entfernt, um das zu benutzen.
END

