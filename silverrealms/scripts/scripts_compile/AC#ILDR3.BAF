IF
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_STONE_SKIN)  // SPWI408.SPL (Steinhaut)
    Global("Prep","LOCALS",0)
THEN
    RESPONSE #70
        ApplySpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Steinhaut)
        Spell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Spiegelbild)
        SetGlobal("Prep","LOCALS",1)
    RESPONSE #100
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_HASTE)  // SPWI305.SPL (Hast)
    !StateCheck(Myself,STATE_HASTED)
    CheckStat(Myself,0,IMPROVEDHASTE)
THEN
    RESPONSE #80
        Spell(Myself,WIZARD_HASTE)  // SPWI305.SPL (Hast)
    RESPONSE #100
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_WEB)  // SPWI215.SPL (Netz)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),WIZARD_WEB)  // SPWI215.SPL (Netz)
    RESPONSE #100
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_STONE_SKIN)  // SPWI408.SPL (Steinhaut)
    CheckStatLT(Myself,1,STONESKINS)
THEN
    RESPONSE #100
        Spell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Steinhaut)
END

IF
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_CHAOS)  // SPWI508.SPL (Chaos)
    HaveSpell(WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Roter Feuerschild)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),WIZARD_CHAOS)  // SPWI508.SPL (Chaos)
        Spell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Roter Feuerschild)
    RESPONSE #100
        Continue()
END

