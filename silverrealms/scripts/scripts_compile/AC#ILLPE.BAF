IF
    See(NearestEnemyOf(Myself))
    GlobalLT("LIGHTNINGMEPHIT","LOCALS",2)
    LevelPartyLT(12)
THEN
    RESPONSE #100
        ForceSpell(NearestEnemyOf(Myself),MEPHIT_LIGHTNING_BOLT)  // SPIN933.SPL (Blitzstrahl)
        IncrementGlobal("LIGHTNINGMEPHIT","LOCALS",1)
        AttackOneRound(NearestEnemyOf(Myself))
END

IF
    LevelPartyLT(12)
    See(NearestEnemyOf(Myself))
    Delay(10)
THEN
    RESPONSE #100
        ForceSpell(NearestEnemyOf(Myself),MEPHIT_BOLT)  // SPIN932.SPL (Blitzstrahl)
END

IF
    LevelPartyGT(11)
    See(NearestEnemyOf(Myself))
    GlobalLT("LIGHTNINGMEPHIT","LOCALS",2)
THEN
    RESPONSE #100
        ReallyForceSpell(NearestEnemyOf(Myself),WIZARD_LIGHTNING_BOLT)  // SPWI308.SPL (Blitzstrahl)
        IncrementGlobal("LIGHTNINGMEPHIT","LOCALS",1)
        AttackOneRound(NearestEnemyOf(Myself))
END

IF
    See(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        EquipMostDamagingMelee()
        AttackReevaluate(NearestEnemyOf(Myself),15)
END

IF
    LevelPartyGT(11)
    See(NearestEnemyOf(Myself))
    Delay(10)
THEN
    RESPONSE #100
        ReallyForceSpell(NearestEnemyOf(Myself),WIZARD_LIGHTNING_BOLT)  // SPWI308.SPL (Blitzstrahl)
END

