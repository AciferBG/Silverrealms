IF
    GlobalGT("AC#Talked_to_Maldraedior","GLOBAL",0)
THEN
    RESPONSE #100
        DestroySelf()
END

IF
    Range([PC],12)
    See([PC])
    Allegiance(Myself,NEUTRAL)
THEN
    RESPONSE #100
        Enemy()
        SetGlobal("Lizard_Attack","ACIL70",1)
END

IF
    See(NearestEnemyOf(Myself))
    OR(2)
        LevelPartyGT(16)
        DifficultyGT(HARD)
    Global("AnimateSkeletons","LOCALS",0)
    GlobalGT("Lizard_Attack","ACIL70",0)
    !GlobalTimerNotExpired("BD_Cast","LOCALS")
THEN
    RESPONSE #100
        SetGlobal("AnimateSkeletons","LOCALS",1)
        ReallyForceSpellRES("AC#IL70","AC#IL701")  // Tote beleben
        ActionOverride("AC#IL701",DestroySelf())
        ReallyForceSpellRES("AC#IL70","AC#IL702")  // Tote beleben
        ActionOverride("AC#IL702",DestroySelf())
        ReallyForceSpellRES("AC#IL70","AC#IL703")  // Tote beleben
        ActionOverride("AC#IL703",DestroySelf())
        ReallyForceSpellRES("AC#IL70","AC#IL704")  // Tote beleben
        ActionOverride("AC#IL704",DestroySelf())
        ReallyForceSpellRES("AC#IL70","AC#IL705")  // Tote beleben
        ActionOverride("AC#IL705",DestroySelf())
        ReallyForceSpellRES("AC#IL70","AC#IL706")  // Tote beleben
        ActionOverride("AC#IL706",DestroySelf())
        ReallyForceSpellRES("AC#IL70","AC#IL707")  // Tote beleben
        ActionOverride("AC#IL707",DestroySelf())
        ReallyForceSpellRES("AC#IL70","AC#IL708")  // Tote beleben
        ActionOverride("AC#IL708",DestroySelf())
        ReallyForceSpellRES("AC#IL70","AC#IL709")  // Tote beleben
        ActionOverride("AC#IL709",DestroySelf())
        SetGlobalTimer("BD_Cast","LOCALS",ONE_ROUND)
        IncrementGlobal("Spells_Cast","LOCALS",1)
END

