IF
    HaveSpellRES("AC#C402")  // Tiere beschwören I
    OR(2)
        See(NearestEnemyOfType([0.0.0.MAGE_ALL]))
        See(NearestEnemyOfType([0.0.0.CLERIC_ALL]))
    !GlobalTimerNotExpired("BD_Cast","LOCALS")
THEN
    RESPONSE #100
        SpellRES("AC#C402",LastSeenBy(Myself))  // Tiere beschwören I
        SetGlobalTimer("BD_Cast","LOCALS",ONE_ROUND)
        IncrementGlobal("Spells_Cast","LOCALS",1)
END

IF
    See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("BD_Cast","LOCALS")
    HaveSpell(CLERIC_CHANT)  // SPPR203.SPL (Gesang)
THEN
    RESPONSE #100
        Spell(Myself,CLERIC_CHANT)  // SPPR203.SPL (Gesang)
        SetGlobalTimer("BD_Cast","LOCALS",ONE_ROUND)
END

