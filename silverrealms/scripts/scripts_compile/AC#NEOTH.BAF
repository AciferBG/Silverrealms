IF
    Global("bd_combat","locals",0)
    Detect(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        SetGlobal("bd_combat","locals",1)
        SetGlobalTimer("PSIONIC_DIMENSION_WALK","locals",FOUR_ROUNDS)
        SetGlobalTimer("bd_breath_weapon","locals",FIVE_ROUNDS)
        SetMusic(COMBAT_NORMAL,BPC1)
        Continue()
END

IF
    Detect(Myself)
    Global("bd_combat","locals",1)
    !Global("bd_search_timer","locals",0)
    GlobalTimerNotExpired("bd_search_timer","locals")
    OR(2)
        !See(NearestEnemyOf(Myself))
        !WeaponEffectiveVs(NearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(SecondNearestEnemyOf(Myself))
        !WeaponEffectiveVs(SecondNearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(ThirdNearestEnemyOf(Myself))
        !WeaponEffectiveVs(ThirdNearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(FourthNearestEnemyOf(Myself))
        !WeaponEffectiveVs(FourthNearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(FifthNearestEnemyOf(Myself))
        !WeaponEffectiveVs(FifthNearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(SixthNearestEnemyOf(Myself))
        !WeaponEffectiveVs(SixthNearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(SeventhNearestEnemyOf(Myself))
        !WeaponEffectiveVs(SeventhNearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(EighthNearestEnemyOf(Myself))
        !WeaponEffectiveVs(EighthNearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(NinthNearestEnemyOf(Myself))
        !WeaponEffectiveVs(NinthNearestEnemyOf(Myself),MAINHAND)
    OR(2)
        !See(TenthNearestEnemyOf(Myself))
        !WeaponEffectiveVs(TenthNearestEnemyOf(Myself),MAINHAND)
    False()
THEN
    RESPONSE #100
        NoAction()
END

IF
    Global("bd_combat","locals",1)
    !Global("bd_search_timer","locals",0)
    GlobalTimerNotExpired("bd_search_timer","locals")
    See(LastSeenBy)
    !Range(LastSeenBy,0)
    !StateCheck(LastSeenBy,STATE_REALLY_DEAD)
    WeaponEffectiveVs(LastSeenBy,MAINHAND)
THEN
    RESPONSE #100
        SetGlobal("bd_search_timer","locals",0)
        Continue()
END

IF
    !GlobalTimerNotExpired("bd_cast","locals")
    Detect(Myself)
    HPPercentLT(Myself,80)
    DifficultyGT(EASY)
    !GlobalTimerNotExpired("PSIONIC_TASTE_LINK","locals")
    OR(3)
        !See(NearestEnemyOf(Myself))
        !CheckSpellState(NearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(NearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(SecondNearestEnemyOf(Myself))
        !CheckSpellState(SecondNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(SecondNearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(ThirdNearestEnemyOf(Myself))
        !CheckSpellState(ThirdNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(ThirdNearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(FourthNearestEnemyOf(Myself))
        !CheckSpellState(FourthNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(FourthNearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(FifthNearestEnemyOf(Myself))
        !CheckSpellState(FifthNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(FifthNearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(SixthNearestEnemyOf(Myself))
        !CheckSpellState(SixthNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(SixthNearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(SeventhNearestEnemyOf(Myself))
        !CheckSpellState(SeventhNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(SeventhNearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(EighthNearestEnemyOf(Myself))
        !CheckSpellState(EighthNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(EighthNearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(NinthNearestEnemyOf(Myself))
        !CheckSpellState(NinthNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(NinthNearestEnemyOf(Myself),TASTE_LINK)
    OR(3)
        !See(TenthNearestEnemyOf(Myself))
        !CheckSpellState(TenthNearestEnemyOf(Myself),POTION_OF_HEALING)
        CheckSpellState(TenthNearestEnemyOf(Myself),TASTE_LINK)
    False()
THEN
    RESPONSE #100
        NoAction()
END

IF
    !GlobalTimerNotExpired("bd_cast","locals")
    HPPercentLT(Myself,80)
    DifficultyGT(EASY)
    !GlobalTimerNotExpired("PSIONIC_TASTE_LINK","locals")
    See(LastSeenBy)
    !Range(LastSeenBy,0)
    !StateCheck(LastSeenBy,STATE_REALLY_DEAD)
    CheckSpellState(LastSeenBy,POTION_OF_HEALING)
THEN
    RESPONSE #100
        SetGlobalTimer("PSIONIC_TASTE_LINK","locals",TWO_ROUNDS)
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDecRES("AC#NEO1",LastSeenBy)  // Taste Link
    RESPONSE #35
        Continue()
END

IF
    !GlobalTimerNotExpired("bd_cast","locals")
    Detect(Myself)
    DifficultyGT(EASY)
    !GlobalTimerNotExpired("PSIONIC_DOMINATION","locals")
    OR(8)
        !See(NearestEnemyOfType([0.0.0.FIGHTER_ALL]))
        StateCheck(NearestEnemyOfType([0.0.0.FIGHTER_ALL]),STATE_DISABLED)
        !CheckStat(NearestEnemyOfType([0.0.0.FIGHTER_ALL]),0,CLERIC_CHAOTIC_COMMANDS)
        CheckSpellState(NearestEnemyOfType([0.0.0.FIGHTER_ALL]),STATE_ENRAGED)
        CheckSpellState(NearestEnemyOfType([0.0.0.FIGHTER_ALL]),POTION_OF_CLARITY)
        !CheckStatGT(NearestEnemyOfType([0.0.0.FIGHTER_ALL]),0,SAVEVSSPELL)
        Race(NearestEnemyOfType([0.0.0.FIGHTER_ALL]),ELF)
        HasItemEquiped("helm06",NearestEnemyOfType([0.0.0.FIGHTER_ALL]))  // Helm zum Schutz vor Bezauberung
    OR(8)
        !See(SecondNearestEnemyOfType([0.0.0.FIGHTER_ALL]))
        StateCheck(SecondNearestEnemyOfType([0.0.0.FIGHTER_ALL]),STATE_DISABLED)
        !CheckStat(SecondNearestEnemyOfType([0.0.0.FIGHTER_ALL]),0,CLERIC_CHAOTIC_COMMANDS)
        CheckSpellState(SecondNearestEnemyOfType([0.0.0.FIGHTER_ALL]),STATE_ENRAGED)
        CheckSpellState(SecondNearestEnemyOfType([0.0.0.FIGHTER_ALL]),POTION_OF_CLARITY)
        !CheckStatGT(SecondNearestEnemyOfType([0.0.0.FIGHTER_ALL]),0,SAVEVSSPELL)
        Race(SecondNearestEnemyOfType([0.0.0.FIGHTER_ALL]),ELF)
        HasItemEquiped("helm06",SecondNearestEnemyOfType([0.0.0.FIGHTER_ALL]))  // Helm zum Schutz vor Bezauberung
    OR(8)
        !See(ThirdNearestEnemyOfType([0.0.0.FIGHTER_ALL]))
        StateCheck(ThirdNearestEnemyOfType([0.0.0.FIGHTER_ALL]),STATE_DISABLED)
        !CheckStat(ThirdNearestEnemyOfType([0.0.0.FIGHTER_ALL]),0,CLERIC_CHAOTIC_COMMANDS)
        CheckSpellState(ThirdNearestEnemyOfType([0.0.0.FIGHTER_ALL]),STATE_ENRAGED)
        CheckSpellState(ThirdNearestEnemyOfType([0.0.0.FIGHTER_ALL]),POTION_OF_CLARITY)
        !CheckStatGT(ThirdNearestEnemyOfType([0.0.0.FIGHTER_ALL]),0,SAVEVSSPELL)
        Race(ThirdNearestEnemyOfType([0.0.0.FIGHTER_ALL]),ELF)
        HasItemEquiped("helm06",ThirdNearestEnemyOfType([0.0.0.FIGHTER_ALL]))  // Helm zum Schutz vor Bezauberung
    OR(8)
        !See(NearestEnemyOfType([0.0.0.RANGER_ALL]))
        StateCheck(NearestEnemyOfType([0.0.0.RANGER_ALL]),STATE_DISABLED)
        !CheckStat(NearestEnemyOfType([0.0.0.RANGER_ALL]),0,CLERIC_CHAOTIC_COMMANDS)
        CheckSpellState(NearestEnemyOfType([0.0.0.RANGER_ALL]),STATE_ENRAGED)
        CheckSpellState(NearestEnemyOfType([0.0.0.RANGER_ALL]),POTION_OF_CLARITY)
        !CheckStatGT(NearestEnemyOfType([0.0.0.RANGER_ALL]),0,SAVEVSSPELL)
        Race(NearestEnemyOfType([0.0.0.RANGER_ALL]),ELF)
        HasItemEquiped("helm06",NearestEnemyOfType([0.0.0.RANGER_ALL]))  // Helm zum Schutz vor Bezauberung
    OR(8)
        !See(SecondNearestEnemyOfType([0.0.0.RANGER_ALL]))
        StateCheck(SecondNearestEnemyOfType([0.0.0.RANGER_ALL]),STATE_DISABLED)
        !CheckStat(SecondNearestEnemyOfType([0.0.0.RANGER_ALL]),0,CLERIC_CHAOTIC_COMMANDS)
        CheckSpellState(SecondNearestEnemyOfType([0.0.0.RANGER_ALL]),STATE_ENRAGED)
        CheckSpellState(SecondNearestEnemyOfType([0.0.0.RANGER_ALL]),POTION_OF_CLARITY)
        !CheckStatGT(SecondNearestEnemyOfType([0.0.0.RANGER_ALL]),0,SAVEVSSPELL)
        Race(SecondNearestEnemyOfType([0.0.0.RANGER_ALL]),ELF)
        HasItemEquiped("helm06",SecondNearestEnemyOfType([0.0.0.RANGER_ALL]))  // Helm zum Schutz vor Bezauberung
    OR(8)
        !See(ThirdNearestEnemyOfType([0.0.0.RANGER_ALL]))
        StateCheck(ThirdNearestEnemyOfType([0.0.0.RANGER_ALL]),STATE_DISABLED)
        !CheckStat(ThirdNearestEnemyOfType([0.0.0.RANGER_ALL]),0,CLERIC_CHAOTIC_COMMANDS)
        CheckSpellState(ThirdNearestEnemyOfType([0.0.0.RANGER_ALL]),STATE_ENRAGED)
        CheckSpellState(ThirdNearestEnemyOfType([0.0.0.RANGER_ALL]),POTION_OF_CLARITY)
        !CheckStatGT(ThirdNearestEnemyOfType([0.0.0.RANGER_ALL]),0,SAVEVSSPELL)
        Race(ThirdNearestEnemyOfType([0.0.0.RANGER_ALL]),ELF)
        HasItemEquiped("helm06",ThirdNearestEnemyOfType([0.0.0.RANGER_ALL]))  // Helm zum Schutz vor Bezauberung
    False()
THEN
    RESPONSE #100
        NoAction()
END

IF
    !GlobalTimerNotExpired("bd_cast","locals")
    DifficultyGT(EASY)
    !GlobalTimerNotExpired("PSIONIC_DOMINATION","locals")
    See(LastSeenBy)
    !Range(LastSeenBy,0)
    !StateCheck(LastSeenBy,STATE_REALLY_DEAD)
    !StateCheck(LastSeenBy,STATE_DISABLED)
    CheckStat(LastSeenBy,0,CLERIC_CHAOTIC_COMMANDS)
    !CheckSpellState(LastSeenBy,STATE_ENRAGED)
    !CheckSpellState(LastSeenBy,POTION_OF_CLARITY)
    CheckStatGT(LastSeenBy,0,SAVEVSSPELL)
    !Race(LastSeenBy,ELF)
    !HasItemEquiped("helm06",LastSeenBy)  // Helm zum Schutz vor Bezauberung
THEN
    RESPONSE #100
        SetGlobalTimer("PSIONIC_DOMINATION","locals",FIVE_ROUNDS)
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDec(LastSeenBy,PSIONIC_DOMINATION)  // SPIN910.SPL (Beherrschung)
END

