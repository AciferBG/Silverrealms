IF
    See(NearestEnemyOf(Myself))
    Global("bd_combat","locals",0)
THEN
    RESPONSE #100
        SetGlobal("bd_combat","locals",1)
        AnkhegEmerge()
        AttackReevaluate(NearestEnemyOf(Myself),6)
END

IF
    See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("bd_breath_weapon","locals")
    !GlobalTimerNotExpired("bd_cast","locals")
    GlobalLT("bd_breath_weapon","locals",2)
    DifficultyGT(EASY)
THEN
    RESPONSE #100
        AnkhegEmerge()
        SetGlobalTimer("bd_breath_weapon","locals",FIVE_ROUNDS)
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        IncrementGlobal("bd_breath_weapon","myarea",1)
        ForceSpellRES("AC#NEOB",LastSeenBy(Myself))  // Schwarzer Drache: Odemwaffe
        ReallyForceSpellRES("spin691v",LastSeenBy(Myself))  // No such index
END

IF
    !GlobalTimerNotExpired("bd_cast","locals")
    HPPercentLT(Myself,80)
    DifficultyGT(EASY)
    !GlobalTimerNotExpired("PSIONIC_TASTE_LINK","locals")
    See(NearestEnemyOf(Myself))
    !StateCheck(LastSeenBy,STATE_REALLY_DEAD)
    CheckSpellState(LastSeenBy,POTION_OF_HEALING)
THEN
    RESPONSE #100
        AnkhegEmerge()
        SetGlobalTimer("PSIONIC_TASTE_LINK","locals",TWO_ROUNDS)
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDecRES("AC#NEO1",LastSeenBy)  // Taste Link
    RESPONSE #35
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("bd_cast","locals")
    DifficultyGT(EASY)
    !GlobalTimerNotExpired("PSIONIC_DOMINATION","locals")
THEN
    RESPONSE #100
        AnkhegEmerge()
        SetGlobalTimer("PSIONIC_DOMINATION","locals",FIVE_ROUNDS)
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDec(LastSeenBy,PSIONIC_DOMINATION)  // SPIN910.SPL (Beherrschung)
END

IF
    See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("bd_cast","locals")
    !GlobalTimerNotExpired("PSIONIC_DOMINATION","locals")
THEN
    RESPONSE #100
        SetGlobalTimer("PSIONIC_DOMINATION","locals",FIVE_ROUNDS)
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDec(LastSeenBy,PSIONIC_DOMINATION)  // SPIN910.SPL (Beherrschung)
    RESPONSE #50
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("bd_cast","locals")
    !GlobalTimerNotExpired("PSIONIC_TELEKINESIS","locals")
    GlobalLT("bd_telekinetic_sword","myarea",6)
    OR(2)
        GlobalLT("bd_telekinetic_sword","myarea",1)
        !DifficultyLT(EASY)
    OR(2)
        GlobalLT("bd_telekinetic_sword","myarea",2)
        !DifficultyLT(NORMAL)
    OR(2)
        GlobalLT("bd_telekinetic_sword","myarea",4)
        !DifficultyLT(HARD)
    OR(2)
        GlobalLT("bd_telekinetic_sword","myarea",6)
        Difficulty(HARDEST)
THEN
    RESPONSE #100
        IncrementGlobal("bd_telekinetic_sword","myarea",1)
        SetGlobalTimer("PSIONIC_TELEKINESIS","locals",TWO_ROUNDS)
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDecRES("AC#NEO2",LastSeenBy)  // Telekinese
    RESPONSE #40
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("bd_cast","locals")
THEN
    RESPONSE #100
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDec(LastSeenBy,PSIONIC_EGOWHIP)  // SPIN909.SPL (Egopeitsche)
    RESPONSE #50
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("bd_cast","locals")
THEN
    RESPONSE #100
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDecRES("AC#NEO3",LastSeenBy)  // Control Body
    RESPONSE #50
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
    !GlobalTimerNotExpired("bd_cast","locals")
THEN
    RESPONSE #100
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDecRES("AC#NEO4",LastSeenBy)  // Geistige Verwirrung
    RESPONSE #50
        Continue()
END

IF
    See(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        AttackReevaluate(LastSeenBy,30)
END

IF
    Global("bd_combat","locals",1)
    !Detect(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        RandomWalkContinuous()
END

