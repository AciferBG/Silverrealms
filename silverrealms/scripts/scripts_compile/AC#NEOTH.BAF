IF
    !GlobalTimerNotExpired("bd_cast","locals")
    !GlobalTimerNotExpired("PSIONIC_TELEKINESIS","locals")
    See(LastSeenBy)
    !Range(LastSeenBy,0)
    !StateCheck(LastSeenBy,STATE_REALLY_DEAD)
    GlobalLT("bd_telekinetic_sword","myarea",6)
    OR(2)
        GlobalLT("bd_telekinetic_sword","myarea",1)
        !DifficultyLT(EASY)
    OR(2)
        GlobalLT("bd_telekinetic_sword","myarea",2)
        !DifficultyLT(NORMAL)
    OR(2)
        GlobalLT("bd_telekinetic_sword","myarea",4)
        !DifficultyLT(HARD)
    OR(2)
        GlobalLT("bd_telekinetic_sword","myarea",6)
        Difficulty(HARDEST)
THEN
    RESPONSE #100
        IncrementGlobal("bd_telekinetic_sword","myarea",1)
        SetGlobalTimer("PSIONIC_TELEKINESIS","locals",TWO_ROUNDS)
        SetGlobalTimer("bd_cast","locals",ONE_ROUND)
        SpellNoDecRES("AC#NEO2",LastSeenBy)  // Telekinese
    RESPONSE #40
        Continue()
END

