IF
	See("AC#4ITH2")
	See(NearestEnemyOf(Myself))
	!Dead("AC#4ITH2")
	Range("AC#4ITH2",30)
	HaveSpellRES("AC#0702")  
THEN
	RESPONSE #100
		SpellRES("AC#0702",Myself) // Invisibility 10 foot (enemy version)
END

