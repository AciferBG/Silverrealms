IF
	NumTimesTalkedTo(0)
	Detect([PC])
	Range(LastSeenBy(Myself),20)
THEN
	RESPONSE #100
		ApplySpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Steinhaut)
		ApplySpell(Myself,WIZARD_VOCALIZE)  // SPWI219.SPL (Stummer Zauber)
		ApplySpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Spiegelbild)
		ApplySpell(Myself,WIZARD_SPELL_DEFLECTION)  // SPWI618.SPL (Zauberabwehr)
		StartDialogNoSet(LastSeenBy(Myself))
END

IF
	StateCheck(Myself,STATE_SILENCED)
THEN
	RESPONSE #100
		ForceSpell(Myself,WIZARD_VOCALIZE)  // SPWI219.SPL (Stummer Zauber)
END

IF
	Allegiance(Myself,ENEMY)
	Global("behaviour","LOCALS",0)
	CheckStatLT(Myself,1,STONESKINS)
THEN
	RESPONSE #100
		DisplayString(Myself,29736)  // Notfall: Steinhaut
		ApplySpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Steinhaut)
		SetGlobal("behaviour","LOCALS",1)
END

