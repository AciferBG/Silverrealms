IF
    HPPercentLT("AC#CHARV",50)  // Charvekannathor
    Global("MoveToHeal","ACIL47",0)
    !Global("HealWorkaround","ACIL47",3)
THEN
    RESPONSE #100
        SetGlobal("MoveToHeal","ACIL47",1)
        ActionOverride("AC#CHARV",ForceSpell(LastSeenBy(Myself),DRAGON_WING_BUFFET))  // SPIN695.SPL (Flügelschlag)
        ActionOverride("AC#CHARV",MoveToPointNoInterrupt([609.661]))
END

