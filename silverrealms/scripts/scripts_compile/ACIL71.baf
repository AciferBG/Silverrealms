IF
	Global("AC#_DragonSummon","GLOBAL",10)
	Global("AC#_Dragon_Warning","ACIL71",0)
THEN
	RESPONSE #100
		SetGlobal("AC#_Dragon_Warning","ACIL71",1)
		Wait(3)
                DisplayString(Player1,@121)
END