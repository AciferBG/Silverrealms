// NEW:
IF
    Global("AC#Maldraedior","ACIL71",1)
THEN
    RESPONSE #100
        ClearAllActions()
        StartCutSceneMode()
		MoveViewObject("Tracil72",INSTANT)
		Wait(1)
		AmbientActivate("Portal",TRUE)
		SoundActivate("Portal_sound",TRUE)
		TriggerActivation("Tracil72",TRUE) 
		SetGlobal("AC#Maldraedior","ACIL71",2)
        EndCutSceneMode()
END

IF
	Global("AC#Talked_to_Maldraedior","GLOBAL",1)
    Global("DeactivatePortalsAgain","ACIL71",0)
THEN
    RESPONSE #100
		AmbientActivate("Portal",FALSE)
		SoundActivate("Portal_sound",FALSE)
		TriggerActivation("Tracil72",FALSE) 
		SetGlobal("DeactivatePortalsAgain","ACIL71",1)
END

IF
	Global("AC#_DragonHeart","ACIL71",1)
THEN
	RESPONSE #100
		SetGlobal("AC#_DragonHeart","ACIL71",2)
		Wait(4)
		CreateCreatureImpassable("AC#MALD1",[491.286],13) // Drachenstatue
               	EndCutSceneMode()
END

IF	
	PartyHasItem("AC#DHE")
	OpenState("Door14",FALSE)
THEN
	RESPONSE #100
		PlaySound("EFF_M04")
		OpenDoor("Door14")
		AmbientActivate("Cold_veil",FALSE)
		SoundActivate("Coldveil_amb",FALSE)
END

