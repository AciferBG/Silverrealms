IF
	Contains("ac#02de1",Myself)
	Global("AC#_deersummon","ACIL02",0)
THEN
	RESPONSE #100
                SetInterrupt(FALSE)
		DestroyItem("ac#02de1")
		PlaySound("EFF_P92")
		DisplayString(Myself,@134)
		SetGlobal("AC#_deersummon","ACIL02",1)
		ContainerEnable("ac#code",FALSE)
                CreateCreature("AC#SPIDE",[915.395],1)
		SetInterrupt(TRUE)
END

