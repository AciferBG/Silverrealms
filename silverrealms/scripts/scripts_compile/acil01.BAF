IF
	Global("EnteredArea","ACIL01",0)
THEN
	RESPONSE #100
		FadeToColor([0.0],0)
		SetGlobal("EnteredArea","ACIL01",1)
		StartCutSceneMode()
		StartCutScene("AC#2UCT1")
END

IF
    Global("WayToACIL09","ACIL01",0)
THEN
    RESPONSE #100
        SetGlobal("WayToACIL09","ACIL01",1)
        TriggerActivation("Tracil09",FALSE)
END
