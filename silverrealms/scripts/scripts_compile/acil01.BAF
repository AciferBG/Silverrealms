IF
	InMyArea(Player1)
	Global("DROWITEMCHECKDONE","ACIL01",1)
	OR(15)
		PartyHasItem("AC#DWCH2")  // Drow-Elfenkettenhemd +1
		PartyHasItem("DWCHAN01")  // Drow-Kettenhemd +3
		PartyHasItem("DWCHAN02")  // Drow-Adamantitkettenhemd +5
		PartyHasItem("DWSW1H01")  // Drow-Krummsäbel +3
		PartyHasItem("DWSW1H02")  // Drow-Langschwert +3
		PartyHasItem("DWBLUN01")  // Drow-Flegel +3
		PartyHasItem("DWHALB01")  // Drow-Hellebarde +3
		PartyHasItem("DWSPER01")  // Drow-Lanze +3
		PartyHasItem("DWXBOW01")  // Drow-Schnellschussarmbrust +3
		PartyHasItem("DWSHLD01")  // Drow-Schild +3
		PartyHasItem("DWCLCK01")  // Drow-Piwafwi
		PartyHasItem("DWBOLT01")  // Drow-Bolzen des Schlafs
		PartyHasItem("DWBOLT02")  // Drow-Bolzen der Betäubung
		PartyHasItem("DWBOLT03")  // Drow-Bolzen +1
		PartyHasItem("DWPLAT01")  // Drow-Prunkharnisch +5
THEN
	RESPONSE #100
		SetGlobal("DROWITEMCHECKDONE","ACIL01",0)
		Continue()
END

IF
	InMyArea(Player1)
	Global("DROWITEMCHECKDONE","ACIL01",0)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		Continue()
END

IF
	InMyArea(Player1)
	Global("DROWITEMCHECKDONE","ACIL01",0)
	HasItem("AC#DWCH2",Player1)  // Drow-Elfenkettenhemd +1
THEN
	RESPONSE #100
		GiveItemCreate("DWDUST",Player1,0,0,0)  // Adamantitstaub
		TakePartyItemAll("AC#DWCH2")  // Drow-Elfenkettenhemd +1
		Continue()
END

