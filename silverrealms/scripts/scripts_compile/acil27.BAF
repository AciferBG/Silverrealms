			 //EraseJournalEntry(@56111)
               SetGlobal("AC#RC_Sorni_Fourth","GLOBAL",8)
END

IF
	Global("AC#RC_Sorni_Fourth","GLOBAL",8)
	CombatCounter(0)
THEN
	RESPONSE #100
	         ClearAllActions()
                 StartCutSceneMode()
                 MoveViewPoint([3676.902],VERY_FAST)
                 ActionOverride(Player1,JumpToPoint([3676.902]))
		ActionOverride(Player2,JumpToPoint([3670.909]))
		ActionOverride(Player3,JumpToPoint([3679.912]))
		ActionOverride(Player4,JumpToPoint([3671.898]))
		ActionOverride(Player5,JumpToPoint([3680.902]))
		ActionOverride(Player6,JumpToPoint([3682.904]))
		CreateCreature("AC#HATH8",[3416.965],8)
                ActionOverride("AC#HATH8",MoveToPointNoInterrupt([3767.1027]))
	         Wait(1)
               CreateCreature("AC#BRES8",[3416.965],8)
                ActionOverride("AC#BRES8",MoveToPointNoInterrupt([3784.892]))
               Wait(1)
               CreateCreature("AC#ELER8",[3391.1012],8)
                ActionOverride("AC#ELER8",MoveToPointNoInterrupt([3786.953]))
                Wait(1)
               CreateCreature("AC#27BS1",[3416.965],8)
               CreateCreature("AC#27BS2",[3248.948],8)
               Wait(1)
               ActionOverride("AC#27BS1",MoveToPointNoInterrupt([3986.831]))
               ActionOverride("AC#27BS2",MoveToPointNoInterrupt([3950.963]))
               Wait(1)
               CreateCreature("AC#27DW1",[3416.965],8)
               CreateCreature("AC#27DW2",[3248.948],8)
               ActionOverride("AC#27DW1",MoveToPointNoInterrupt([3931.1005]))
               ActionOverride("AC#27DW2",MoveToPointNoInterrupt([3977.804]))
               Wait(1)
               CreateCreature("AC#27DW3",[3416.965],8)
               CreateCreature("AC#27DW4",[3248.948],8)
               CreateCreature("AC#27DW5",[3241.951],8)
               ActionOverride("AC#27DW3",MoveToPointNoInterrupt([3616.847]))
               ActionOverride("AC#27DW4",MoveToPointNoInterrupt([3619.907]))
               ActionOverride("AC#27DW5",MoveToPointNoInterrupt([3626.968]))
               Wait(7)
               //TriggerActivation("TrACIL20",FALSE)
	       	//TriggerActivation("Info_ACIL20",TRUE)
               SetGlobal("AC#RC_Sorni_Fourth","GLOBAL",9)
               EndCutSceneMode()
               ActionOverride("AC#BRES8",StartDialogueNoSet(Player1))
END

IF
	Global("AC#RC_Sorni_Fourth","GLOBAL",10)
THEN
	RESPONSE #100
	         ClearAllActions()
                 StartCutSceneMode()
                 MoveViewPoint([3676.902],VERY_FAST)
                 ActionOverride("AC#27BS1",Face(11))
		ActionOverride("AC#27BS2",Face(12))
                 ActionOverride("AC#27BS1",SwingOnce())
		ActionOverride("AC#27BS2",SwingOnce())
		FadeToColor([15.0],0)
		Wait(1)
               CreateCreature("AC#SORN8",[3241.951],8)
               Wait(1)
               PlaySound("ac#spla1")
               SmallWait(15)
               OpenDoor("Door01")
			   TriggerActivation("TrACIL28",FALSE)
               Wait(1)
		FadeFromColor([15.0],0)
               ActionOverride("AC#SORN8",MoveToPointNoInterrupt([3573.909]))
               EndCutSceneMode()
               SetGlobal("AC#RC_Sorni_Fourth","GLOBAL",11)
               ActionOverride("AC#SORN8",StartDialogueNoSet(Player1))
END

