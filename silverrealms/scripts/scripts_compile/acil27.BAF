IF
	Global("AC#Runecontainer02","ACIL27",1)
THEN
	RESPONSE #100
		PlaySound("EFF_M62")
		AmbientActivate("Monolith02on",TRUE)
		AmbientActivate("Monolith02off",FALSE)
		SpawnPtDeactivate("Spawnpointwater")
		SetGlobal("AC#Runecontainer02","ACIL27",2)
END

IF
	Global("AC#Runecontainer02","ACIL27",2)
	Global("MonolithsDeactivated","ACIL27",0)
THEN
	RESPONSE #100
	        AmbientActivate("Monolith01off",FALSE)
                AmbientActivate("Monolith01on",FALSE)
                AmbientActivate("Monolith02on",FALSE)
		AmbientActivate("Monolith02off",FALSE)
                AmbientActivate("Monolith03off",FALSE)
                AmbientActivate("Monolith03on",FALSE)
                AmbientActivate("Monolith04off",FALSE)
                AmbientActivate("Monolith04on",FALSE)
                AmbientActivate("Monolith05off",FALSE)
                AmbientActivate("Monolith05on",FALSE)
       		TakePartyItem("AC#IL#01")
		DestroyItem("AC#IL#01")
		TakePartyItem("AC#IL#02")
		DestroyItem("AC#IL#02")
		TakePartyItem("AC#IL#03")
		DestroyItem("AC#IL#03")
		ActionOverride("Runecontainer01",DisplayString(Myself,@886))
       		ContainerEnable("Runecontainer01",FALSE)
		ContainerEnable("Runecontainer02",FALSE)
		ContainerEnable("Runecontainer03",FALSE)
		SetGlobal("MonolithsDeactivated","ACIL27",1)
		//EraseJournalEntry(@27000)
END

IF
        Global("AC#DOOR03","ACIL27",1)
THEN
	RESPONSE #100
	//ClearAllActions()
	//StartCutSceneMode()
	MoveViewPoint([2034.1461],INSTANT)
	ScreenShake([20.20],20)
        OpenDoor("Door03")
		//EraseJournalEntry(@56101)
		AddJournalEntry(@56102,QUEST)
        SetGlobal("AC#DOOR03","ACIL27",2) // DOOR03 to ACIL2K is opened
END

IF
	Global("AC#Runecontainer01","ACIL27",1)
	Global("AC#Rune01Spawn","ACIL27",0)
THEN
