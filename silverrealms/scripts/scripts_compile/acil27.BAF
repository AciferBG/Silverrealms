IF
    Global("DisableAnimations","ACIL27",0)
THEN
    RESPONSE #100
        SetGlobal("DisableAnimations","ACIL27",1)
        AmbientActivate("Monolith02on",FALSE)
        AmbientActivate("Monolith01off",FALSE)
        AmbientActivate("Monolith03off",FALSE)
        AmbientActivate("Monolith04off",FALSE)
        AmbientActivate("Monolith05off",FALSE)
        SpawnPtDeactivate("Madness_spawn_01")
        SpawnPtDeactivate("Madness_spawn_02")
        SpawnPtDeactivate("Madness_spawn_03")
        Continue()
END

