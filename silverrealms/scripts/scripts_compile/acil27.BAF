IF
	Global("AC#Ruvan_Treason","GLOBAL",1)
	Global("ChangeFolks","ACIL27",0)
THEN
	RESPONSE #100
               SetGlobal("ChangeFolks","ACIL27",1)
               OpenDoor("Door02")
			   TriggerActivation("TrACIL28",FALSE)
               ActionOverride("AC#SORN8",DestroySelf()) // Sorni
               ActionOverride("AC#27BS1",DestroySelf()) // Boatsmith1
	       ActionOverride("AC#27BS2",DestroySelf()) // Boatsmith2
               ActionOverride("AC#BRES8",DestroySelf()) // Bresk
               ActionOverride("AC#ELER8",DestroySelf()) // Elern
               ActionOverride("AC#27DW1",JumpToPoint([2820.728]))  // Soldat Iltkazars 1
               ActionOverride("AC#27DW2",JumpToPoint([2744.759]))  // Soldat Iltkazars 2
               ActionOverride("AC#27DW3",JumpToPoint([2966.834]))  // Ruvan Houseguard
               ActionOverride("AC#27DW4",JumpToPoint([2894.853]))  // Ruvan Houseguard
               ActionOverride("AC#27DW5",JumpToPoint([2843.865]))  // Ruvan Houseguard
               ActionOverride("AC#HATH8",JumpToPoint([2907.762])) // Hathar
               ActionOverride("AC#HATH8",SetNumTimesTalkedTo(1))
END

IF
    Global("ShriekerAttractMonster","ACIL27",1)
    Global("ShriekMonstTimerStart","ACIL27",0)
THEN
    RESPONSE #100
        SetGlobal("ShriekerAttractMonster","ACIL27",0)
        SetGlobal("ShriekMonstTimerStart","ACIL27",1)
        SetGlobalTimer("ShriekerMonsterTimer","ACIL27",ONE_ROUND)
END

IF
    Global("ShriekerAttractMonster","ACIL27",1)
    Global("ShriekMonstTimerStart","ACIL27",1)
    GlobalLT("ShriekMonstTimerSTOP","ACIL27",5)
    GlobalTimerExpired("ShriekerMonsterTimer","ACIL27")
THEN
    RESPONSE #100
        SetGlobal("ShriekerAttractMonster","ACIL27",0)
        IncrementGlobal("ShriekMonstTimerSTOP","ACIL27",1)
        SetGlobalTimer("ShriekerMonsterTimer","ACIL27",ONE_ROUND)
        CreateCreatureOffScreen("AC#KUOTY",S)  // Riesenspinne
        CreateCreatureOffScreen("AC#KUOTY",S)  // Riesenspinne
        CreateCreatureOffScreen("AC#KUOTY",S)  // Riesenspinne
        CreateCreatureOffScreen("AC#KUOTY",S)  // Riesenspinne
END