IF
	Global("SpawnPointMadness","ACIL27",0)
	Global("AC#kuotoa_madness","GLOBAL",1)
THEN
	RESPONSE #100
                SpawnPtDeactivate("Spawn Point 1") // deactivate previous Spawnpoints
                SpawnPtDeactivate("Spawn Point 2")
                SpawnPtDeactivate("Spawn Point 3")
                SpawnPtDeactivate("Spawn Point 4")
				SpawnPtActivate("Madness_spawn_01") // activate Gogondy-wine spawn points
				SpawnPtActivate("Madness_spawn_02")
				SpawnPtActivate("Madness_spawn_03")
                SetGlobal("SpawnPointMadness","ACIL27",1)
END

IF
	Global("SpawnPointActivation","ACIL27",0)
	Global("MonolithsDeactivated","ACIL27",1)
	Global("AC#RC_Sorni_Fourth","GLOBAL",7)
THEN
	RESPONSE #100
                SpawnPtDeactivate("Spawn Point 1")
                SpawnPtDeactivate("Spawn Point 2")
                SpawnPtDeactivate("Spawn Point 3")
                SpawnPtDeactivate("Spawn Point 4")
                SetGlobal("SpawnPointActivation","ACIL27",1)
                SetGlobal("AC#kuotoa_madness","GLOBAL",2)
END


