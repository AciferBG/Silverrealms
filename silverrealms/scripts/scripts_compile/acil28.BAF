IF
	Global("EnteredArea","ACIL28",0)
THEN
	RESPONSE #100
		FadeToColor([0.0],0)
		SetGlobal("EnteredArea","ACIL28",1)
		TextScreen("AC#MOS27")
		OpenDoor("Door06")
		AmbientActivate("Eyesocket01",FALSE)
        AmbientActivate("Eyesocket02",FALSE)
        TriggerActivation("Info_Boats",FALSE)
        TriggerActivation("TrACIL27",FALSE)
		AmbientActivate("Smoke_wood",FALSE)		
		FadeFromColor([30.0],0)
END

IF
	OpenState("DOOR05",TRUE)
	Global("HiddenVoiceSpawn","ACIL28",0)
THEN
	RESPONSE #100
		SetGlobal("HiddenVoiceSpawn","ACIL28",1)
		CreateCreatureImpassableAllowOverlap("AC#IL28F",[2232.1675],S)  // Hidden Voice: Undead Elderbrain
END

IF
    GlobalGT("MindflayersAppear","ACIL28",0)
    Global("LockDoor05","ACIL28",0)
THEN
    RESPONSE #100
        SetGlobal("LockDoor05","ACIL28",1)
        CloseDoor("DOOR05")
        Lock("DOOR05")
END

IF
    Global("FireballBrain","ACIL28",1)
THEN
    RESPONSE #100
        CreateCreatureImpassableAllowOverlap("AC#IL28G",[2196.1589],S)  // Untotes Ältestenhirn
        SetGlobal("FireballBrain","ACIL28",2)
END

IF
    Dead("AC#IL28G")
	Global("AC#IL_KilledElderBrain","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("AC#IL_KilledElderBrain","GLOBAL",1)
        CreateVisualEffect("AC#IL54B",[2196.1589])
        ScreenShake([20.20],5)
        OpenDoor("DOOR07")
        AmbientActivate("Smoke_wood",TRUE)
END

IF
	Dead("AC#NEOTH") // EE: Neothelid is killed
	CombatCounter(0)
	Global("ElderBrainSpawn","ACIL28",0)
THEN
	RESPONSE #100
		ClearAllActions()
		SetGlobal("ElderBrainSpawn","ACIL28",1)
		StartCutSceneMode()
		MoveViewPoint([2196.1589],INSTANT)
		CreateCreatureImpassableAllowOverlap("CUTSPY",[2190.1600],S)
		CreateVisualEffect("ICPRAYI",[2196.1589])
		CreateCreatureImpassableAllowOverlap("AC#IL28E",[2196.1589],S)  // Undead Elderbrain
		Wait(2)
		ActionOverride("CUTSPY",DestroySelf())
		ActionOverride("AC#IL28E",StartDialogueNoSet([PC]))
END

