IF
	GlobalGT("AC#Ruvan_Treason","GLOBAL",0)
	Global("Door06Closed","ACIL28",0)
THEN
	RESPONSE #100
	         CloseDoor("Door06")
	         TriggerActivation("Info_Boats",TRUE)
               SetGlobal("Door06Closed","ACIL28",1)
END

