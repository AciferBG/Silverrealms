THEN
	RESPONSE #100
	         SetInterrupt(FALSE)
                 Wait(3)
               SetGlobal("EllhimarTalks","ACIL28",1)
               SetInterrupt(TRUE)
               ActionOverride("AC#ILEL8",StartDialogueNoSet(Player1))
END
*/

IF
	Global("ACIL28_BOATGONE","ACIL28",1)
THEN
	RESPONSE #100
			Wait(1)
	         ClearAllActions()
                 StartCutSceneMode()
				 Wait(1)
                 MoveViewPoint([406.1653],VERY_FAST)
                 CreateVisualEffect("ICFRACTI",[406.1653])
                 Wait(1)
                 AmbientActivate("Eyesocket01",TRUE)
                AmbientActivate("Eyesocket02",TRUE)
                Wait(1)
                MoveViewPoint([602.1654],VERY_FAST)
                CreateCreature("AC#ILDUM",[602.1654],8) // Erscheinung
                Wait(1)
                CreateVisualEffect("ICFRACTI",[602.1654])
                ActionOverride("AC#ILDUM",DropItem("AC#HADUM",[-1.-1]))
                Wait(1)
                ActionOverride("AC#ILDUM",DestroySelf())
               SetGlobal("ACIL28_BOATGONE","ACIL28",2)
               AmbientActivate("Eyesocket01",FALSE)
                AmbientActivate("Eyesocket02",FALSE)
                EndCutSceneMode()
				EraseJournalEntry(@62046)
				AddJournalEntry(@62047,QUEST)
END

IF
	Delay(3)
	Global("Ambush01","ACIL28",1)
	GlobalLT("Ambush01Stop","ACIL28",5)
THEN
	RESPONSE #100
		CreateCreature("AC#28LA2",[935.1026],7)  // Lacedon
		CreateCreature("AC#28LA2",[984.1213],7)  // Lacedon
		CreateCreature("AC#28LA2",[240.774],0)  // Lacedon
		IncrementGlobal("Ambush01Stop","ACIL28",1)
END