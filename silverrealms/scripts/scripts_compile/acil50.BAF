// when Reputation in Iltkazar is high enough, the players are summoned to the regency council again
IF
	InMyArea(Player1)
	Global("AC#Arrested","GLOBAL",1)
	GlobalGT("AC_Iltkazar_Reputation","GLOBAL",9) // new: 10 rep points
THEN
	RESPONSE #100
	        SetGlobal("AC#Arrested","GLOBAL",2)
            SetGlobal("AC#Iltkazar_Council_Second_Quest","GLOBAL",1)
	         CreateCreatureObjectOffset("ac#dun50",Player1,[5.5])  // Dunnabar Steinschulter
END

