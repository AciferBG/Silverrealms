IF
	Global("EnteredArea","ACIL50",0)
THEN
	RESPONSE #100
		FadeToColor([0.0],0)
		SetGlobal("EnteredArea","ACIL50",1)
		StartMovie("AC#ILTKA")
		OpenDoor("DOOR03")
		TriggerActivation("Tracil63",FALSE)
		TriggerActivation("TrACIL58",FALSE)
		TriggerActivation("TrACIL51",FALSE)
		TriggerActivation("TrAcil52",FALSE)
		TriggerActivation("TrAcil53",FALSE)
		TriggerActivation("TrAcil54",FALSE)
		TriggerActivation("TrAcil55",FALSE)
		TriggerActivation("TrAcil56",FALSE)
		FadeFromColor([30.0],0)
END

IF
    InMyArea(Player1)
    Global("MalphasCutsceneTiamat","ACIL50",0)
    GlobalGT("AC#IL_Spiderstalkings","GLOBAL",0)
THEN
    RESPONSE #100
        FadeToColor([8.0],0)
        SetGlobal("MalphasCutsceneTiamat","ACIL50",1)
        StartCutSceneMode()
        StartCutScene("AC#2TCT1")
END

IF
	InMyArea(Player1)
	Global("MalphasCutscene#2","ACIL50",0) 
	GlobalGT("AC#ACIL64_Open","GLOBAL",0) 
THEN
	RESPONSE #100
		FadeToColor([8.0],0)
		SetGlobal("MalphasCutscene#2","ACIL50",1)  
		//SmallWait(5)
		StartCutSceneMode()
		StartCutScene("AC#T2CT2")
END

IF
	Global("AC#AzerkynDestroyed","GLOBAL",1)
THEN
	RESPONSE #100
	         FadeToColor([0.0],0)
		SetGlobal("AC#AzerkynDestroyed","GLOBAL",2)
		SetGlobal("AC#_Iltkazar_Destroyed","GLOBAL",1)
		CloseDoor("Door03")
		Unlock("DOOR02")
		OpenDoor("DOOR02")
		AmbientActivate("Arnskull_Flame",FALSE)
		TriggerActivation("Tracil62",FALSE)
                TriggerActivation("Tracil63",TRUE)
                ActionOverride("AC#BRES1",DestroySelf())
                CreateCreature("AC#DUN03",[868.681],6)  // Dunnabar
                CreateCreature("AC#SORN3",[799.770],6)  // Sorni
                CreateCreature("AC#ANT03",[901.666],6)  // Anthan in ACIL50 after the destruction of arnskull hall
		FadeFromColor([30.0],0)
		ActionOverride("AC#DUN03",Dialogue(Player1))
END

/*
Die PCs werden vor den Eingang des Ratsgeb�udes teleportiert
*/

IF
	Global("AC#Bresk_Teleport","ACIL50",1)
THEN
	RESPONSE #100
                 ClearAllActions()
                 StartCutSceneMode()
                 SetGlobal("AC#Bresk_Teleport","ACIL50",2)
	        FadeToColor([15.0],0)
		Wait(1)
		ActionOverride("AC#BRES1",JumpToPoint([2928.370]))
		ActionOverride(Player1,JumpToPoint([2931.379]))
		ActionOverride(Player2,JumpToPoint([2931.379]))
		ActionOverride(Player3,JumpToPoint([2931.379]))
		ActionOverride(Player4,JumpToPoint([2931.379]))
		ActionOverride(Player5,JumpToPoint([2931.379]))
		ActionOverride(Player6,JumpToPoint([2931.379]))
		MoveViewPoint([2931.379],INSTANT)
		Wait(1)
		FadeFromColor([15.0],0)
		EndCutSceneMode()
		ActionOverride("AC#BRES1",Dialogue(Player1))
END

IF
	Global("AC#Bresk_Teleport","ACIL50",3)
THEN
	RESPONSE #100
                 ClearAllActions()
                 StartCutSceneMode()
                 SetGlobal("AC#Bresk_Teleport","ACIL50",4)
	        FadeToColor([15.0],0)
		Wait(1)
		StartCutScene("ac#ct50A")
END

// after first talk to the regency council, the party is arrested
IF
	Global("AC#BreskWatches","ACIL50",2)
	Global("AC#RegencyQuest","GLOBAL",1)
	Global("AC#Arrested","GLOBAL",0)
THEN
	RESPONSE #100
	    Wait(1)
		SetGlobal("AC#Arrested","GLOBAL",1)
	    AddJournalEntry(@55100,QUEST)
END

