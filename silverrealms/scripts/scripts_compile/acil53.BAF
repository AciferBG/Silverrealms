                 SetGlobal("AC#MetagolemName","ACIL53",2)
END
*/

IF
    Global("ElernSpawn","ACIL53",1)
THEN
    RESPONSE #100
        SetGlobal("ElernSpawn","ACIL53",2)
        CreateCreatureObjectOffset("AC#ELER5",Player1,[15.15])  // Elern Abgrundlied
        ActionOverride("AC#ELER5",Dialogue(Player1))
END

IF
	GlobalGT("AC#IL_TasteLobeMyself","GLOBAL",4)
	Global("CloseDoorCerndAgain","ACIL53",0)
THEN
	RESPONSE #100
		CloseDoor("DOOR01")
		Lock("DOOR01")
		SetGlobal("CloseDoorCerndAgain","ACIL53",1)
END

IF
	Global("Prison_Cernd","ACIL53",1)
THEN
	RESPONSE #100
		Unlock("DOOR01")
		OpenDoor("DOOR01")
		SetGlobal("Prison_Cernd","ACIL53",2)
END

IF
	Global("AC#Ellhimar_Cernd","GLOBAL",4)
       	Exists("AC#53CE1")  // Cernd's Guard
THEN
	RESPONSE #100
		ActionOverride("AC#53CE1",DestroySelf())
END

IF
	Global("AC#Ellhimar_Cernd","GLOBAL",4)
       	Exists("AC#53CE2")  // Cernd's Guard
THEN
	RESPONSE #100
		ActionOverride("AC#53CE2",DestroySelf())
END
