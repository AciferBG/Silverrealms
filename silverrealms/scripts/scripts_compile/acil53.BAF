
IF
	Global("EnteredArea","ACIL53",0)
THEN
	RESPONSE #100
	        ScreenShake([50.50],15)
	        PlaySound("AM5000S3")
		SetGlobal("EnteredArea","ACIL53",1)
END

IF
	Global("EnteredArea","ACIL53",1)
THEN
	RESPONSE #100
                Wait(1)
		SetGlobal("EnteredArea","ACIL53",2)
		ActionOverride("AC#JOUR1",StartDialogueNoSet(Player1))
END

IF
	GlobalGT("AC#TalkedToBettargh","ACIL53",0)
	Global("ExplosivesSeller","ACIL53",0)
THEN
	RESPONSE #100
		SetGlobal("ExplosivesSeller","ACIL53",1)
		CreateCreature("AC#53SVM",[1457.275],0)
END

IF
	Global("AC#bookbinder","ACIL53",1)
	Global("AC#bookbinder_hint","ACIL53",0)
THEN
	RESPONSE #100
		SetGlobal("AC#bookbinder_hint","ACIL53",1)
	        AddJournalEntry(@53100,QUEST)
END

IF
	Global("Book_Labyrinth","ACIL53",1)
	PartyHasItem("AC#53BK3")
THEN
	RESPONSE #100
		SetGlobal("Book_Labyrinth","ACIL53",2)
	    AddJournalEntry(@53301,QUEST)
END

//now in dlg file
/*
IF
	Global("AC#MetagolemIngredients","ACIL53",3)
THEN
	RESPONSE #100
                 SetGlobal("AC#MetagolemIngredients","ACIL53",4)
                 ClearAllActions()
                 StartCutSceneMode()
	         StartCutScene("AC#53CT1")
END
*/

IF
	Global("AC#MetagolemIngredients","ACIL53",6)
THEN
	RESPONSE #100
	         SetInterrupt(FALSE)
                 Wait(2)
                 SetGlobal("AC#MetagolemIngredients","ACIL53",7)
                 FadeToColor([15.0],0)
                 Wait(2)
                 FadeFromColor([15.0],0)
                 Wait(2)
                 CreateCreatureOffScreen("AC#GOLM2",0)
                 ActionOverride("AC#GOLM2",ReallyForceSpell(Myself,GOLEM_HASTE))
	         SetInterrupt(TRUE)
                 ActionOverride("AC#GOLM2",Dialogue(Player1))
END

IF
    Global("Metagolem_Rep_Increase","ACIL53",0)
    GlobalGT("AC#MetagolemIngredients","ACIL53",7)
THEN
    RESPONSE #100
        SetGlobal("Metagolem_Rep_Increase","ACIL53",1)
        IncrementGlobal("AC_Iltkazar_Reputation","GLOBAL",1)
        DisplayString(Myself,@1021)  // ^0xFF22B4E6Euer Ansehen in Iltkazar ist gestiegen.^-
END
