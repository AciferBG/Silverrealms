IF
	True()
THEN
	RESPONSE #100
		CutSceneId(Player1)
		StorePartyLocations()
		DisplayStringHead(Myself,999999)
		PlayDead(45)
		ActionOverride(Player2,PlayDead(45))
		ActionOverride(Player3,PlayDead(45))
		ActionOverride(Player4,PlayDead(45))
		ActionOverride(Player5,PlayDead(45))
		ActionOverride(Player6,PlayDead(45))
		FadeToColor([30.0],0)
		Wait(1)
		Wait(1)
		LeaveAreaLUAPanic("ACILD2","",[0.0],0)
		LeaveAreaLUA("ACILD2","",[0.0],8)
		ActionOverride(Player2,LeaveAreaLUA("ACILD2","",[0.0],2))
		ActionOverride(Player3,LeaveAreaLUA("ACILD2","",[0.0],14))
		ActionOverride(Player4,LeaveAreaLUA("ACILD2","",[0.0],0))
		ActionOverride(Player5,LeaveAreaLUA("ACILD2","",[0.0],4))
		ActionOverride(Player6,LeaveAreaLUA("ACILD2","",[0.0],2))
		MultiPlayerSync()
		MoveViewPoint([374.1333],INSTANT)
		ApplySpell(Player2,SURE_SLEEP) // SPIN892.SPL (Schlaf)
		ApplySpell(Player3,SURE_SLEEP) // SPIN892.SPL (Schlaf)
		ApplySpell(Player4,SURE_SLEEP) // SPIN892.SPL (Schlaf)
		ApplySpell(Player5,SURE_SLEEP) // SPIN892.SPL (Schlaf)
		ApplySpell(Player6,SURE_SLEEP) // SPIN892.SPL (Schlaf)
		Explore()
		SmallWait(5)
		FadeFromColor([40.0],0)
		ActionOverride("AC#DREA1",MoveToPoint([1543.379]))
		Wait(5)
		MoveViewPoint([1543.379],5)
		Wait(10)
		//ActionOverride("AC#DREA1",Face(2))
		//ActionOverride("AC#DREA1",SmallWait(5))
		//MoveViewObject("AC#DREA1",5)
		Wait(3)
		ActionOverride("AC#DREA2",StartDialogueNoSet(Player1))
		//FadeToColor([50.0],0)
		//RestorePartyLocations()
		//MultiPlayerSync()
		//FadeFromColor([30.0],0)
		//EndCutSceneMode()
		//RestParty()
END

